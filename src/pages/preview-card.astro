---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const cases = await getCollection('cases');
const item = cases.find((c) => c.id === 'gordaomod')!;
const lang = 'pt';
const href = `/pt/cases/${item.id}/`;
const liveUrl = item.data.liveUrl;
const heroImage = '/cases/gordaomod-card.jpg';
const metrics = item.data.businessOutcome?.slice(0, 3) ?? [];
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Preview Card — Gordaomod (clone do Frotamais pela metade)</title>
  </head>
  <body class="min-h-screen bg-brand-bg text-brand-text antialiased p-8 md:p-16">
    <div class="max-w-6xl mx-auto">
      <h1 class="text-2xl font-bold text-brand-text-secondary mb-8">Preview — clone do card do Frotamais, pela metade, com dados do Gordaomod</h1>

      {/* Card clone do FeaturedCase, mas ocupando metade da largura */}
      <div class="max-w-xl">
        <div
          class="relative overflow-hidden rounded-3xl border border-brand-border bg-gradient-to-br from-brand-surface/80 to-brand-bg/60 shadow-[0_24px_80px_-24px_rgba(0,0,0,0.6)] backdrop-blur-md motion-safe:transition-transform motion-safe:duration-200 hover:-translate-y-0.5"
        >
          {/* Ambient gradients */}
          <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
            <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-brand-accent-secondary/10 to-transparent"></div>
            <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-brand-bg/70 to-transparent"></div>
          </div>

          {/* Imagem em cima — mesmo tamanho do featured, sem mudar */}
          <div class="relative aspect-[4/3] rounded-2xl overflow-hidden border-b border-brand-border bg-brand-bg/40 shadow-[0_16px_48px_-16px_rgba(0,0,0,0.5)]">
            <div class="absolute inset-0 flex items-center justify-center p-4">
              <img
                src={heroImage}
                alt={`Prévia da aplicação ${item.data.title}`}
                width="400"
                height="300"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-top drop-shadow-2xl"
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-brand-bg/70 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
          </div>

          {/* Conteúdo embaixo — texto otimizado para metade do espaço */}
          <div class="relative p-6 md:p-8">
            {/* Logo + cliente */}
            <div class="inline-flex items-center gap-3 mb-4">
              <img
                src={heroImage}
                alt={`Logotipo do cliente ${item.data.clientName}`}
                width="36"
                height="36"
                loading="lazy"
                decoding="async"
                class="w-9 h-9 object-contain rounded-lg bg-brand-bg/40 p-1 border border-brand-border"
              />
              <span class="text-xs font-medium text-brand-text-secondary font-mono">
                {item.data.clientName}
              </span>
            </div>

            {/* Título */}
            <h2 class="font-display text-2xl md:text-3xl font-black leading-[1.05] tracking-[-0.03em] text-brand-text mb-3">
              {item.data.title}
            </h2>

            {/* Descrição — line-clamp-3 para caber */}
            <p class="text-sm text-brand-text-secondary mb-6 leading-relaxed line-clamp-3">
              {item.data.shortDescription}
            </p>

            {/* Métricas compactas */}
            <div class="grid grid-cols-3 gap-3 mb-6">
              {metrics.map((metric) => (
                <div class="border-l-2 border-brand-accent/30 pl-3">
                  <span class="block text-lg font-black text-brand-accent font-mono leading-none">
                    {metric.value}{metric.unit || ''}
                  </span>
                  <span class="text-[10px] text-brand-text-secondary mt-1 block">{metric.label}</span>
                </div>
              ))}
            </div>

            {/* Dois botões — mesmos do featured */}
            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href={href}
                class="inline-flex items-center justify-center min-h-[44px] px-5 py-2.5 bg-brand-accent text-brand-bg font-bold text-sm rounded-xl hover:scale-105 motion-safe:transition-transform motion-safe:duration-200 shadow-[0_0_24px_rgba(138,180,248,0.35)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
              >
                Ver case completo →
              </a>
              {liveUrl && (
                <a
                  href={liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center min-h-[44px] px-5 py-2.5 border border-brand-border text-brand-text font-semibold text-sm rounded-xl hover:border-brand-accent/60 hover:text-brand-accent motion-safe:transition-colors motion-safe:duration-200 bg-brand-surface/40 backdrop-blur-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
                >
                  Abrir aplicação ↗
                </a>
              )}
            </div>
          </div>
        </div>
      </div>

      <p class="mt-8 text-sm text-brand-text-secondary max-w-xl">
        Clone do card do Frotamais. Mesma estrutura: gradiente ambiente, borda, imagem 4:3 em cima,
        logo + cliente, título, descrição, métricas, dois botões. Só que ocupando metade da largura (max-w-xl).
        Imagem mantém o mesmo tamanho. Texto otimizado com line-clamp-3 e métricas compactas.
      </p>
    </div>
  </body>
</html>
