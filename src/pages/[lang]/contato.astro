---
import '../../styles/global.css';
import { ui } from '../../i18n/ui';
import Fonts from '../../components/Fonts.astro';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  const langs: (keyof typeof ui)[] = ['pt', 'en'];
  return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
type ValidLang = keyof typeof ui;
const currentLang: ValidLang = (lang as ValidLang) in ui ? (lang as ValidLang) : 'pt';

const htmlLangMap = { pt: 'pt-BR', en: 'en-US' } as const;
const htmlLang = htmlLangMap[currentLang];
const t = ui[currentLang];

const site = 'https://expostacker.com.br';
const ptUrl = `${site}/pt/contato/`;
const enUrl = `${site}/en/contato/`;
const canonicalUrl = currentLang === 'pt' ? ptUrl : enUrl;
const xDefaultUrl = ptUrl;

const title = currentLang === 'pt'
  ? 'Contato — contratar desenvolvimento de produto digital | Expo Stacker'
  : 'Contact — hire digital product development | Expo Stacker';
const description = currentLang === 'pt'
  ? 'Fale comigo para construir seu produto digital. SaaS, e-commerce, site, MVP ou automação com IA. Resposta em até 24 horas.'
  : 'Get in touch to build your digital product. SaaS, e-commerce, website, MVP, or AI automation. Reply within 24 hours.';
const keywords = currentLang === 'pt'
  ? 'contratar desenvolvedor, contato desenvolvimento de software, orçamento SaaS, orçamento e-commerce, desenvolvedor full stack, proposta de desenvolvimento, consultoria de produto digital'
  : 'hire developer, software development contact, SaaS quote, e-commerce quote, full stack developer, development proposal, digital product consulting';

const skipLinkText = currentLang === 'pt' ? 'Pular para o conteúdo' : 'Skip to content';
const nameHelp = currentLang === 'pt' ? 'Como você gostaria de ser chamado?' : 'How would you like to be addressed?';
const emailHelp = currentLang === 'pt' ? 'Usado apenas para responder a esta mensagem.' : 'Used only to reply to this message.';
const messageHelp = currentLang === 'pt' ? 'Conte o contexto do projeto e o problema que precisa resolver.' : 'Share the project context and the problem you need solved.';
const errorRequired = currentLang === 'pt' ? 'Este campo é obrigatório.' : 'This field is required.';

const breadcrumbs = [
  { name: currentLang === 'pt' ? 'Início' : 'Home', url: `${site}/${currentLang}/` },
  { name: currentLang === 'pt' ? 'Contato' : 'Contact', url: canonicalUrl },
];

const whatsappUrl = 'https://wa.me/5513999999999?text=' + encodeURIComponent(
  currentLang === 'pt' ? 'Olá! Tenho um projeto para conversar.' : 'Hi! I have a project to discuss.'
);
const emailDirect = 'contato@expostacker.com.br';
const githubUrl = 'https://github.com/lfelipef1dev-jpg';

const channels = [
  {
    label: t['contact.whatsapp'],
    desc: t['contact.whatsappDesc'],
    href: whatsappUrl,
    external: true,
    icon: 'whatsapp',
  },
  {
    label: t['contact.emailDirect'],
    desc: t['contact.emailDirectDesc'],
    href: `mailto:${emailDirect}`,
    external: false,
    icon: 'email',
  },
  {
    label: t['contact.github'],
    desc: t['contact.githubDesc'],
    href: githubUrl,
    external: true,
    icon: 'github',
  },
];
---

<html lang={htmlLang}>
  <head>
    <Fonts />
    <BaseHead
      title={title}
      description={description}
      lang={currentLang}
      canonicalUrl={canonicalUrl}
      ptUrl={ptUrl}
      enUrl={enUrl}
      xDefaultUrl={xDefaultUrl}
      keywords={keywords}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-brand-bg text-brand-text antialiased">
    <a href="#main-content" class="skip-link">{skipLinkText}</a>
    <Header lang={currentLang} />
    <main id="main-content" class="flex-1 pt-20 md:pt-24 pb-16 md:pb-20">
      <div class="max-w-6xl mx-auto px-6 md:px-10">
        <!-- Header -->
        <div class="mb-10">
          <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-3 flex items-center gap-2">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-accent" aria-hidden="true"></span>
            {t['contact.eyebrow']}
          </p>
          <h1 class="font-display text-3xl md:text-5xl text-brand-text tracking-tight leading-tight mb-3">
            {t['contact.title']}
          </h1>
          <p class="text-base text-brand-text-secondary leading-relaxed">
            {t['contact.subtitle']}
          </p>
          <div class="mt-4 inline-flex items-center gap-2 rounded-full border border-brand-accent/30 bg-brand-accent/8 px-3 py-1.5">
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-accent opacity-75 motion-reduce:animate-none"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-accent"></span>
            </span>
            <span class="text-xs font-mono text-brand-accent">{t['contact.responseTime']}</span>
          </div>
        </div>

        <!-- Grid: canais + formulario -->
        <div class="grid lg:grid-cols-[1fr_1.3fr] gap-8 lg:gap-12 items-start">
          <!-- Coluna esquerda: canais diretos -->
          <div class="flex flex-col gap-5">
            <div>
              <h2 class="font-mono text-xs uppercase tracking-widest text-brand-text-secondary mb-4">
                {t['contact.directTitle']}
              </h2>
              <div class="flex flex-col gap-3">
                {channels.map((channel) => (
                  <a
                    href={channel.href}
                    target={channel.external ? '_blank' : undefined}
                    rel={channel.external ? 'noopener noreferrer' : undefined}
                    class="group flex items-start gap-3 p-4 rounded-xl border border-brand-border bg-brand-surface/40 hover:border-brand-accent/40 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand-bg"
                  >
                    <span class="shrink-0 flex items-center justify-center w-9 h-9 rounded-lg border border-brand-border bg-brand-bg/60 text-brand-accent">
                      {channel.icon === 'whatsapp' && (
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                      )}
                      {channel.icon === 'email' && (
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <rect x="2" y="4" width="20" height="16" rx="2"/>
                          <path d="m22 7-10 5L2 7"/>
                        </svg>
                      )}
                      {channel.icon === 'github' && (
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                        </svg>
                      )}
                    </span>
                    <span class="flex flex-col gap-0.5">
                      <span class="font-display text-sm text-brand-text leading-snug group-hover:text-brand-accent transition-colors">
                        {channel.label}
                      </span>
                      <span class="text-xs text-brand-text-secondary leading-relaxed">
                        {channel.desc}
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            </div>

            <!-- Localizacao -->
            <div class="p-4 rounded-xl border border-brand-border bg-brand-surface/20">
              <p class="font-mono text-xs uppercase tracking-wider text-brand-text-secondary mb-1">
                {t['contact.location']}
              </p>
              <p class="font-display text-sm text-brand-text">
                {t['contact.locationValue']}
              </p>
            </div>
          </div>

          <!-- Coluna direita: formulario -->
          <div class="flex flex-col gap-4">
            <div>
              <h2 class="font-display text-xl md:text-2xl text-brand-text mb-1 leading-snug">
                {t['contact.formTitle']}
              </h2>
              <p class="text-xs text-brand-text-secondary leading-relaxed">
                {t['contact.formDesc']}
              </p>
            </div>

            <form action={t['contact.form.action']} method="POST" class="flex flex-col gap-4 p-5 md:p-6 rounded-2xl border border-brand-border bg-brand-surface/40" novalidate>
              <div>
                <label for="name" class="block text-sm font-medium text-brand-text mb-1.5">{t['contact.name']}</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  aria-describedby="name-help name-error"
                  class="w-full min-h-[44px] px-3 py-2.5 rounded-lg bg-brand-bg border border-brand-border text-brand-text text-sm placeholder-brand-text-secondary/50 focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent"
                />
                <p id="name-help" class="mt-1.5 text-xs text-brand-text-secondary">{nameHelp}</p>
                <p id="name-error" class="mt-1 text-xs text-red-400 hidden" role="alert">{errorRequired}</p>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-brand-text mb-1.5">{t['contact.email']}</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  aria-describedby="email-help email-error"
                  class="w-full min-h-[44px] px-3 py-2.5 rounded-lg bg-brand-bg border border-brand-border text-brand-text text-sm placeholder-brand-text-secondary/50 focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent"
                />
                <p id="email-help" class="mt-1.5 text-xs text-brand-text-secondary">{emailHelp}</p>
                <p id="email-error" class="mt-1 text-xs text-red-400 hidden" role="alert">{errorRequired}</p>
              </div>

              <div>
                <label for="projectType" class="block text-sm font-medium text-brand-text mb-1.5">{t['contact.projectType']}</label>
                <select
                  id="projectType"
                  name="projectType"
                  class="w-full min-h-[44px] px-3 py-2.5 rounded-lg bg-brand-bg border border-brand-border text-brand-text text-sm focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent"
                >
                  <option value="" disabled selected>{t['contact.projectTypePlaceholder']}</option>
                  <option value="saas">{t['contact.projectTypeSaas']}</option>
                  <option value="ecommerce">{t['contact.projectTypeEcommerce']}</option>
                  <option value="site">{t['contact.projectTypeSite']}</option>
                  <option value="other">{t['contact.projectTypeOther']}</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-brand-text mb-1.5">{t['contact.message']}</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  aria-describedby="message-help message-error"
                  class="w-full min-h-[44px] px-3 py-2.5 rounded-lg bg-brand-bg border border-brand-border text-brand-text text-sm placeholder-brand-text-secondary/50 focus:outline-none focus:border-brand-accent focus:ring-1 focus:ring-brand-accent resize-y"
                ></textarea>
                <p id="message-help" class="mt-1.5 text-xs text-brand-text-secondary">{messageHelp}</p>
                <p id="message-error" class="mt-1 text-xs text-red-400 hidden" role="alert">{errorRequired}</p>
              </div>

              <button
                type="submit"
                class="w-full min-h-[44px] px-6 py-3 bg-brand-accent text-brand-bg font-bold text-sm rounded-lg hover:scale-[1.02] transition-transform shadow-[0_0_24px_rgba(138,180,248,0.35)] focus:outline-none focus:ring-2 focus:ring-brand-accent focus:ring-offset-2 focus:ring-offset-brand-bg"
              >
                {t['contact.send']}
              </button>
            </form>
          </div>
        </div>
      </div>
    </main>
    <Footer lang={currentLang} />
  </body>
</html>
