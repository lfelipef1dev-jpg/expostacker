---
import '../../styles/global.css';
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Fonts from '../../components/Fonts.astro';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import HeroBanner from '../../components/HeroBanner.astro';
import TrustBar from '../../components/TrustBar.astro';
import ProblemStatement from '../../components/ProblemStatement.astro';
import Packages from '../../components/Packages.astro';
import BentoGrid from '../../components/BentoGrid.astro';
import ProcessSection from '../../components/ProcessSection.astro';
import About from '../../components/About.astro';
import SocialProof from '../../components/SocialProof.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  const langs: (keyof typeof ui)[] = ['pt', 'en'];
  return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
type ValidLang = keyof typeof ui;
const currentLang: ValidLang = (lang as ValidLang) in ui ? (lang as ValidLang) : 'pt';
const t = useTranslations(currentLang);

const site = 'https://expostacker.com.br';
const ptUrl = `${site}/pt/`;
const enUrl = `${site}/en/`;
const canonicalUrl = currentLang === 'pt' ? ptUrl : enUrl;
const xDefaultUrl = ptUrl;

const title = currentLang === 'pt'
  ? 'Expo Stacker | 11 produtos digitais em produção — construí o seu'
  : 'Expo Stacker | 11 digital products live — build yours';
const description = currentLang === 'pt'
  ? 'Vitrine de produtos digitais em produção. 11 aplicações ao vivo, com domínio próprio e código público. Construo o próximo produto para você.'
  : 'Showcase of live digital products. 11 live applications with custom domains and public code. I build your next product.';
---

<html lang={currentLang === 'pt' ? 'pt-BR' : 'en-US'}>
  <head>
    <Fonts />
    <BaseHead title={title} description={description} lang={currentLang} canonicalUrl={canonicalUrl} ptUrl={ptUrl} enUrl={enUrl} xDefaultUrl={xDefaultUrl} />
  </head>
  <body class="min-h-screen flex flex-col bg-brand-bg text-brand-text antialiased overflow-x-hidden">
    <a href="#main-content" class="skip-link">{t('skip.link')}</a>
    <Header lang={currentLang} />
    <main id="main-content" class="flex-1">
      <HeroBanner lang={currentLang} />
      <TrustBar lang={currentLang} />
      <ProblemStatement lang={currentLang} />
      <Packages lang={currentLang} />
      <BentoGrid lang={currentLang} />
      <ProcessSection lang={currentLang} />
      <About lang={currentLang} />
      <SocialProof lang={currentLang} />
      <LeadMagnet lang={currentLang} />
      <FaqSection lang={currentLang} />
    </main>
    <Footer lang={currentLang} />
  </body>
</html>
