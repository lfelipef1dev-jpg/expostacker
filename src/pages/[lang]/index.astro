---
import '../../styles/global.css';
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Fonts from '../../components/Fonts.astro';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import FeaturedCase from '../../components/FeaturedCase.astro';
import BentoGrid from '../../components/BentoGrid.astro';
import About from '../../components/About.astro';
import SocialProof from '../../components/SocialProof.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  const langs: (keyof typeof ui)[] = ['pt', 'en'];
  return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
type ValidLang = keyof typeof ui;
const currentLang: ValidLang = (lang as ValidLang) in ui ? (lang as ValidLang) : 'pt';
const t = useTranslations(currentLang);

const site = 'https://expostacker.com.br';
const ptUrl = `${site}/pt/`;
const enUrl = `${site}/en/`;
const canonicalUrl = currentLang === 'pt' ? ptUrl : enUrl;
const xDefaultUrl = ptUrl;

const title = currentLang === 'pt'
  ? 'Expo Stacker | Desenvolvedor Full Stack — React, Node.js, TypeScript'
  : 'Expo Stacker | Full Stack Developer — React, Node.js, TypeScript';
const description = currentLang === 'pt'
  ? 'Desenvolvedor Full Stack especializado em React, Node.js e TypeScript. Construo aplicações web escaláveis e performáticas.'
  : 'Full Stack Developer specializing in React, Node.js, and TypeScript. I build scalable, performant web applications.';
---

<html lang={currentLang === 'pt' ? 'pt-BR' : 'en-US'}>
  <head>
    <Fonts />
    <BaseHead title={title} description={description} lang={currentLang} canonicalUrl={canonicalUrl} ptUrl={ptUrl} enUrl={enUrl} xDefaultUrl={xDefaultUrl} />
  </head>
  <body class="min-h-screen flex flex-col bg-brand-bg text-brand-text antialiased overflow-x-hidden">
    <a href="#main-content" class="skip-link">{t('skip.link')}</a>
    <Header lang={currentLang} />
    <main id="main-content" class="flex-1">
      <Hero lang={currentLang} />
      <FeaturedCase lang={currentLang} />
      <BentoGrid lang={currentLang} />
      <About lang={currentLang} />
      <SocialProof lang={currentLang} />
    </main>
    <Footer lang={currentLang} />
  </body>
</html>
