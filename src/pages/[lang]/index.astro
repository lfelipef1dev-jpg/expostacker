---
import '../../styles/global.css';
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Fonts from '../../components/Fonts.astro';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import HeroBanner from '../../components/HeroBanner.astro';
import TrustBar from '../../components/TrustBar.astro';
import ProblemStatement from '../../components/ProblemStatement.astro';
import Packages from '../../components/Packages.astro';
import BentoGrid from '../../components/BentoGrid.astro';
import ProcessSection from '../../components/ProcessSection.astro';
import WhyExpostacker from '../../components/WhyExpostacker.astro';
import About from '../../components/About.astro';
import SocialProof from '../../components/SocialProof.astro';
import LeadMagnet from '../../components/LeadMagnet.astro';
import FaqSection from '../../components/FaqSection.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  const langs: (keyof typeof ui)[] = ['pt', 'en'];
  return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
type ValidLang = keyof typeof ui;
const currentLang: ValidLang = (lang as ValidLang) in ui ? (lang as ValidLang) : 'pt';
const t = useTranslations(currentLang);

const site = 'https://expostacker.com.br';
const ptUrl = `${site}/pt/`;
const enUrl = `${site}/en/`;
const canonicalUrl = currentLang === 'pt' ? ptUrl : enUrl;
const xDefaultUrl = ptUrl;

const title = currentLang === 'pt'
  ? 'ExpoStacker | Produtos Digitais, SaaS, IA e E-commerce'
  : 'ExpoStacker | Digital Products, SaaS, AI and E-commerce';
const description = currentLang === 'pt'
  ? 'Construímos produtos digitais completos — SaaS, plataformas, e-commerce, IA e sistemas — da estratégia ao deploy.'
  : 'We build complete digital products — SaaS, platforms, e-commerce, AI and systems — from strategy to deploy.';
const keywords = currentLang === 'pt'
  ? 'desenvolvimento de produtos digitais, desenvolvedor SaaS, desenvolvedor e-commerce, criar plataforma SaaS, desenvolvedor full stack Brasil, produtos digitais ao vivo, deploy automático, MVP development, automação com IA, chatbot IA, site profissional, landing page conversão, Cloudflare, Supabase, Astro, Next.js'
  : 'digital product development, SaaS developer, e-commerce developer, build SaaS platform, full stack developer Brazil, live digital products, automatic deploy, MVP development, AI automation, AI chatbot, professional website, conversion landing page, Cloudflare, Supabase, Astro, Next.js';

// Speakable selectors (conteúdo elegível para IA/voz)
const speakableSelectors = ['#hero-banner', '#packages-title', '#faq-title'];
---

<html lang={currentLang === 'pt' ? 'pt-BR' : 'en-US'}>
  <head>
    <Fonts />
    <BaseHead
      title={title}
      description={description}
      lang={currentLang}
      canonicalUrl={canonicalUrl}
      ptUrl={ptUrl}
      enUrl={enUrl}
      xDefaultUrl={xDefaultUrl}
      keywords={keywords}
      speakableSelectors={speakableSelectors}
      isHomepage={true}
      dateModified="2026-08-28"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-brand-bg text-brand-text antialiased overflow-x-hidden">
    <a href="#main-content" class="skip-link">{t('skip.link')}</a>
    <Header lang={currentLang} />
    <main id="main-content" class="flex-1">
      <HeroBanner lang={currentLang} />
      <TrustBar lang={currentLang} />
      <ProblemStatement lang={currentLang} />
      <Packages lang={currentLang} />
      <BentoGrid lang={currentLang} />
      <ProcessSection lang={currentLang} />
      <WhyExpostacker lang={currentLang} />
      <About lang={currentLang} />
      <SocialProof lang={currentLang} />
      <LeadMagnet lang={currentLang} />
      <FaqSection lang={currentLang} />
    </main>
    <Footer lang={currentLang} />
  </body>
</html>
