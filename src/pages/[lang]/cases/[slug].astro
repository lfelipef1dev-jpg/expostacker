---
import '../../../styles/global.css';
import { getCollection, type CollectionEntry } from 'astro:content';
import { ui } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

import CaseHeroV2 from '../../../components/case/CaseHeroV2.astro';
import CaseSnapshot from '../../../components/case/CaseSnapshot.astro';
import CaseStory from '../../../components/case/CaseStory.astro';
import CaseTimeline from '../../../components/case/CaseTimeline.astro';
import CaseMethodology from '../../../components/case/CaseMethodology.astro';
import CaseArchitecture from '../../../components/case/CaseArchitecture.astro';
import CaseTechStack from '../../../components/case/CaseTechStack.astro';
import CaseDecisionLog from '../../../components/case/CaseDecisionLog.astro';
import CaseAI from '../../../components/case/CaseAI.astro';
import CaseGamification from '../../../components/case/CaseGamification.astro';
import CaseSecurity from '../../../components/case/CaseSecurity.astro';
import CaseResultsV2 from '../../../components/case/CaseResultsV2.astro';
import CaseLessons from '../../../components/case/CaseLessons.astro';
import CaseCTA from '../../../components/case/CaseCTA.astro';
import CaseRelated from '../../../components/case/CaseRelated.astro';

type ValidLang = keyof typeof ui;

type StaticPath = {
  params: { lang: ValidLang; slug: string };
  props: { lang: ValidLang; slug: string; entry: CollectionEntry<'cases'> };
};

export async function getStaticPaths(): Promise<StaticPath[]> {
  const entries: CollectionEntry<'cases'>[] = await getCollection('cases');
  const langs: ValidLang[] = ['pt', 'en'];

  return langs.flatMap((lang) =>
    entries.map((entry) => ({
      params: { lang, slug: entry.id },
      props: { lang, slug: entry.id, entry }
    }))
  );
}

const { lang, slug, entry } = Astro.props;
const currentLang: ValidLang = (lang as ValidLang) in ui ? (lang as ValidLang) : 'pt';
const t = useTranslations(currentLang);

const htmlLangMap = { pt: 'pt-BR', en: 'en-US' } as const;
const htmlLang = htmlLangMap[currentLang];

const site = 'https://expostacker.com.br';
const ptUrl = `${site}/pt/cases/${slug}/`;
const enUrl = `${site}/en/cases/${slug}/`;
const canonicalUrl = currentLang === 'pt' ? ptUrl : enUrl;
const xDefaultUrl = ptUrl;

const title = currentLang === 'pt'
  ? `${entry.data.title} — Case | Expo Stacker`
  : `${entry.data.title} — Case Study | Expo Stacker`;
const description = (entry.data.shortDescription ?? '').slice(0, 160);
const ogImage = `${site}/og-image.png`;
const heroImage = `${site}/cases/${slug}-hero.jpg`;
const keywords = currentLang === 'pt'
  ? `${entry.data.title}, ${entry.data.clientName}, case de desenvolvimento, produto digital ao vivo, ${entry.data.tags?.join(', ') ?? ''}`
  : `${entry.data.title}, ${entry.data.clientName}, development case study, live digital product, ${entry.data.tags?.join(', ') ?? ''}`;

// BreadcrumbList schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: currentLang === 'pt' ? 'Início' : 'Home', item: `${site}/${currentLang}/` },
    { '@type': 'ListItem', position: 2, name: currentLang === 'pt' ? 'Produtos' : 'Products', item: `${site}/${currentLang}/cases/` },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: canonicalUrl },
  ],
};

// Article schema for case page
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: description,
  image: heroImage,
  url: canonicalUrl,
  author: { '@type': 'Organization', name: 'Expo Stacker', url: site },
  publisher: { '@type': 'Organization', name: 'Expo Stacker', logo: { '@type': 'ImageObject', url: `${site}/logo.png` } },
  datePublished: `${entry.data.year ?? '2025'}-01-01`,
  dateModified: new Date().toISOString().split('T')[0],
  inLanguage: htmlLang,
  keywords: entry.data.tags?.join(', ') ?? '',
  about: entry.data.clientName,
};

// WebPage schema
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: description,
  url: canonicalUrl,
  inLanguage: htmlLang,
  isPartOf: { '@type': 'WebSite', name: 'Expo Stacker', url: site },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: breadcrumbSchema.itemListElement },
};

// ImageObject schema for hero image
const imageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  url: heroImage,
  contentUrl: heroImage,
  caption: `Preview de ${entry.data.title}`,
  representativeOfPage: true,
};

const caseSchemas = [breadcrumbSchema, articleSchema, webPageSchema, imageSchema];
---

<html lang={htmlLang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      lang={currentLang}
      canonicalUrl={canonicalUrl}
      ptUrl={ptUrl}
      enUrl={enUrl}
      xDefaultUrl={xDefaultUrl}
      ogImage={ogImage}
      keywords={keywords}
      type="article"
      schema={caseSchemas}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-brand-bg text-brand-text antialiased overflow-x-hidden">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-3 focus:min-h-[48px] focus:inline-flex focus:items-center focus:bg-brand-accent focus:text-brand-bg focus:font-mono focus:text-sm focus:rounded-lg focus:shadow-lg"
    >
      {t('skip.link')}
    </a>

    <Header lang={currentLang} />

    <main id="main-content" class="flex-1 pt-32 pb-20">
      <article class="max-w-6xl mx-auto px-4 md:px-6">
        <CaseHeroV2 lang={currentLang} entry={entry} slug={slug} />
        <CaseSnapshot lang={currentLang} entry={entry} />
        <CaseResultsV2 lang={currentLang} entry={entry} />
        <div class="bg-brand-surface/20 border-y border-brand-border">
          <section id="case-content">
            <CaseStory lang={currentLang} entry={entry} />
          </section>
        </div>
        <CaseTimeline lang={currentLang} entry={entry} />
        <div class="bg-brand-surface/20 border-y border-brand-border">
          <CaseMethodology lang={currentLang} entry={entry} />
        </div>
        <CaseArchitecture lang={currentLang} entry={entry} />
        <div class="bg-brand-surface/20 border-y border-brand-border">
          <CaseTechStack lang={currentLang} entry={entry} />
        </div>
        <CaseDecisionLog lang={currentLang} entry={entry} />
        <CaseAI lang={currentLang} entry={entry} />
        <div class="bg-brand-surface/20 border-y border-brand-border">
          <CaseGamification lang={currentLang} entry={entry} />
        </div>
        <CaseSecurity lang={currentLang} entry={entry} />
        <CaseLessons lang={currentLang} entry={entry} />
        <CaseRelated lang={currentLang} currentSlug={slug} tags={entry.data.tags} />
        <CaseCTA lang={currentLang} entry={entry} />
      </article>
    </main>

    <Footer lang={currentLang} />
  </body>
</html>
