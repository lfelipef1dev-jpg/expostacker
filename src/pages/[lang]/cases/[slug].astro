---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ui } from '../../../i18n/ui';

type ValidLang = keyof typeof ui;

type StaticPath = {
  params: { lang: ValidLang; slug: string };
  props: { entry: CollectionEntry<'cases'> };
};

export async function getStaticPaths(): Promise<StaticPath[]> {
  const entries: CollectionEntry<'cases'>[] = await getCollection('cases');
  const langs: ValidLang[] = ['pt', 'en'];

  return langs.flatMap((lang) =>
    entries.map((entry) => ({
      params: { lang, slug: entry.id },
      props: { entry }
    }))
  );
}

const { entry } = Astro.props;
const { lang, slug } = Astro.params;

const currentLang: ValidLang = (lang as ValidLang) in ui ? (lang as ValidLang) : 'pt';

const htmlLangMap = { pt: 'pt-BR', en: 'en-US' } as const;
const htmlLang = htmlLangMap[currentLang];

const site = 'https://expostacker.com.br';

const ptUrl = `${site}/pt/cases/${slug}`;
const enUrl = `${site}/en/cases/${slug}`;
const canonicalUrl = currentLang === 'pt' ? ptUrl : enUrl;
const xDefaultUrl = ptUrl;
---

<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <title>{entry.data.title} | Expo Stacker</title>
    <meta name="description" content={entry.data.problemDescription.slice(0, 160)} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-br" href={ptUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
  </head>
  <body class="bg-brand-bg text-brand-text p-8">
    <main class="max-w-4xl mx-auto">
      <div class="border border-brand-surface bg-brand-surface p-6 rounded-xl">
        <h1 class="text-3xl font-bold mb-4">{entry.data.title}</h1>
        <p class="text-brand-accent font-mono mb-4">Cliente: {entry.data.clientName}</p>

        <div class="grid grid-cols-3 gap-4 my-6">
          {entry.data.businessOutcome.map((metric: { label: string; value: number; unit: string }) => (
            <div class="p-4 bg-brand-bg border border-brand-surface rounded-lg text-center">
              <span class="block text-2xl font-black text-brand-accent">{metric.value}{metric.unit}</span>
              <span class="text-xs text-slate-400">{metric.label}</span>
            </div>
          ))}
        </div>

        <div class="prose prose-invert mt-6">
          <h3>{currentLang === 'pt' ? 'O Problema' : 'The Problem'}</h3>
          <p>{entry.data.problemDescription}</p>
          <h3>{currentLang === 'pt' ? 'A Solução Sênior' : 'The Senior Solution'}</h3>
          <p>{entry.data.technicalSolution}</p>
        </div>

        <a href={`/apps/${slug}`} class="inline-block mt-6 px-6 py-3 bg-brand-accent text-brand-bg font-bold rounded-lg transition-transform hover:scale-105">
          {currentLang === 'pt' ? 'Executar Aplicação Viva Ao Vivo ⚡' : 'Run Live Application ⚡'}
        </a>
      </div>
    </main>
  </body>
</html>
