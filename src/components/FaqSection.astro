---
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const faqs = [
  { q: t('faq.q1'), a: t('faq.a1') },
  { q: t('faq.q2'), a: t('faq.a2') },
  { q: t('faq.q3'), a: t('faq.a3') },
  { q: t('faq.q4'), a: t('faq.a4') },
  { q: t('faq.q5'), a: t('faq.a5') },
  { q: t('faq.q6'), a: t('faq.a6') },
  { q: t('faq.q7'), a: t('faq.a7') },
  { q: t('faq.q8'), a: t('faq.a8') },
  { q: t('faq.q9'), a: t('faq.a9') },
  { q: t('faq.q10'), a: t('faq.a10') },
  { q: t('faq.q11'), a: t('faq.a11') },
  { q: t('faq.q12'), a: t('faq.a12') },
  { q: t('faq.q13'), a: t('faq.a13') },
  { q: t('faq.q14'), a: t('faq.a14') },
  { q: t('faq.q15'), a: t('faq.a15') },
  { q: t('faq.q16'), a: t('faq.a16') },
];

// FAQ schema is now injected via index.astro BaseHead, but we keep semantic structure here
---

<section class="py-24 md:py-32 max-w-7xl mx-auto px-6 md:px-10 lg:px-16" aria-labelledby="faq-title">
  <div class="grid lg:grid-cols-[1fr_1.5fr] gap-12 lg:gap-20 items-start">
    {/* Coluna esquerda — titulo + CTA */}
    <div class="flex flex-col gap-8 lg:sticky lg:top-24">
      <div>
        <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 flex items-center gap-2">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-accent" aria-hidden="true"></span>
          {t('faq.eyebrow')}
        </p>
        <h2 id="faq-title" class="font-display text-3xl md:text-5xl lg:text-6xl text-brand-text tracking-tight leading-tight">
          {t('faq.title')}
        </h2>
      </div>
      <a
        href={`/${lang}/contato/`}
        class="inline-flex items-center justify-center px-7 py-4 bg-brand-accent text-brand-bg font-bold rounded-xl hover:scale-105 transition-transform duration-200 shadow-[0_0_32px_rgba(138,180,248,0.35)] min-w-[200px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand-bg"
      >
        {t('faq.cta')} →
      </a>
    </div>

    {/* Coluna direita — FAQ */}
    <div class="flex flex-col gap-3">
      {faqs.map((faq) => (
        <details class="group p-5 rounded-xl border border-brand-border bg-brand-surface/40 hover:border-brand-accent/30 transition-colors motion-reduce:transition-none">
          <summary class="flex items-center justify-between cursor-pointer list-none font-display text-base md:text-lg text-brand-text leading-snug gap-4 min-h-[48px] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand-bg rounded-lg">
            {faq.q}
            <span class="shrink-0 text-brand-accent text-xl font-mono transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-4 text-sm text-brand-text-secondary leading-relaxed">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
