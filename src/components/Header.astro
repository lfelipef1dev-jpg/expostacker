---
import { ui, languages } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const otherLang = lang === 'pt' ? 'en' : 'pt';
const otherLabel = languages[otherLang];

const nav = [
  { href: `/${lang}/`, label: t('nav.cases') },
  { href: `/${lang}/contato/`, label: t('nav.contact') },
];
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-brand-surface/60 bg-brand-bg/80 backdrop-blur-md">
  <nav class="max-w-6xl mx-auto flex items-center justify-between p-4 md:px-6">
    <a href={`/${lang}/`} class="text-xl font-black tracking-tight text-white">
      <span class="text-brand-accent">EXPO</span> STACKER
    </a>
    <div class="flex items-center gap-6 text-sm font-medium">
      {nav.map((item) => (
        <a href={item.href} class="text-slate-300 hover:text-brand-accent transition-colors">
          {item.label}
        </a>
      ))}
      <a
        href={`/${otherLang}/`}
        class="px-3 py-1.5 text-xs font-semibold border border-brand-surface rounded-full text-slate-300 hover:border-brand-accent hover:text-brand-accent transition-colors"
        aria-label={`Mudar para ${otherLabel}`}
      >
        {otherLabel}
      </a>
    </div>
  </nav>
</header>
