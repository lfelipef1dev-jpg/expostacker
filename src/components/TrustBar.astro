---
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stats = [
  { value: '11', label: t('trust.projects') },
  { value: '100%', label: t('trust.live') },
  { value: '8+', label: t('trust.technologies') },
  { value: '100%', label: t('trust.code') },
  { value: 'CI/CD', label: t('trust.deploy') },
];
---

<section class="py-8 md:py-10 border-y border-brand-border/60 bg-brand-surface/30" aria-label={t('trust.title')}>
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-6 md:gap-4">
      {stats.map((stat) => (
        <div class="flex flex-col items-center text-center">
          <span class="font-display text-2xl md:text-3xl font-black text-brand-accent tracking-tight">
            {stat.value}
          </span>
          <span class="text-xs md:text-sm text-brand-text-secondary font-mono mt-1 leading-tight">
            {stat.label}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
