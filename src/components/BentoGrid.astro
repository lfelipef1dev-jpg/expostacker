---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { formatBusinessMetric } from '../utils/format';

export interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const cases: CollectionEntry<'cases'>[] = await getCollection('cases');
const featuredIndex = cases.findIndex((c) => c.data.featured);
const featured = featuredIndex >= 0 ? cases[featuredIndex] : cases[0];
const others = cases.filter((_, i) => i !== (featuredIndex >= 0 ? featuredIndex : 0));
---

<section id="cases" class="max-w-6xl mx-auto px-4 md:px-6 pb-24">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 auto-rows-min">
    <!-- Card 1: Destaque Largo -->
    <article class="md:col-span-2 p-7 rounded-2xl border border-brand-surface bg-brand-surface/60 backdrop-blur-sm flex flex-col justify-between hover:border-brand-accent/40 transition-colors group relative">
      <div>
        <div class="flex items-center gap-2 mb-4">
          <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
          <span class="text-xs font-bold text-brand-accent uppercase tracking-wider">{t('bento.featured.title')}</span>
        </div>
        <h2 class="text-2xl md:text-3xl font-bold mb-3 text-white">{featured.data.title}</h2>
        <p class="text-slate-300 leading-relaxed text-base line-clamp-4">{featured.data.shortDescription}</p>
      </div>
      <a href={`/${lang}/cases/${featured.id}/`} class="mt-6 inline-flex w-fit items-center text-brand-accent font-bold hover:underline group-hover:translate-x-1 transition-colors relative z-10">
        {lang === 'pt' ? 'Ver case completo' : 'Read full case'} →
      </a>
    </article>

    <!-- Card 2: Métricas do Destaque -->
    <div class="p-7 rounded-2xl border border-brand-surface bg-brand-surface/60 backdrop-blur-sm">
      <h3 class="text-xs font-bold text-brand-accent uppercase tracking-wider mb-5">{t('bento.metrics.title')}</h3>
      <div class="grid grid-cols-1 gap-5">
        {featured.data.businessOutcome.slice(0, 3).map((metric: { label: string; value: number; unit: string }) => (
          <div class="border-b border-brand-surface/50 pb-4 last:border-0 last:pb-0">
            <span class="block text-3xl font-black text-brand-accent">{formatBusinessMetric(metric.value, metric.unit)}</span>
            <span class="text-sm text-slate-400">{metric.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Card 3: Tags do Destaque -->
    <div class="p-7 rounded-2xl border border-brand-surface bg-brand-surface/60 backdrop-blur-sm">
      <h3 class="text-xs font-bold text-brand-accent uppercase tracking-wider mb-5">{t('bento.tags.title')}</h3>
      <div class="flex flex-wrap gap-2">
        {featured.data.tags.slice(0, 6).map((tag: string) => (
          <span class="px-3 py-1.5 text-sm font-medium border border-brand-surface rounded-full bg-brand-bg/60 text-slate-300">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Card 4+: Cases secundários -->
    {others.map((item) => (
      <article class="p-6 rounded-2xl border border-brand-surface bg-brand-surface/40 backdrop-blur-sm hover:border-brand-accent/60 hover:bg-brand-surface/70 transition-all group relative">
        <a href={`/${lang}/cases/${item.id}/`} class="block relative z-10">
          <h3 class="text-lg font-bold mb-2 text-white group-hover:text-brand-accent transition-colors">{item.data.title}</h3>
          <p class="text-sm text-slate-400 line-clamp-3 mb-4">{item.data.shortDescription}</p>
          {item.data.businessOutcome[0] && (
            <div class="mb-4">
              <span class="block text-2xl font-black text-brand-accent">{formatBusinessMetric(item.data.businessOutcome[0].value, item.data.businessOutcome[0].unit)}</span>
              <span class="text-xs text-slate-400">{item.data.businessOutcome[0].label}</span>
            </div>
          )}
        </a>
        <div class="flex flex-wrap gap-2 relative z-10">
          {item.data.tags.slice(0, 4).map((tag: string) => (
            <span class="px-2.5 py-1 text-xs font-medium border border-brand-surface rounded-full bg-brand-bg/60 text-slate-400">
              {tag}
            </span>
          ))}
        </div>
        <a href={`/${lang}/cases/${item.id}/`} class="absolute inset-0 z-0" aria-hidden="true" tabindex="-1"></a>
      </article>
    ))}
  </div>
</section>
