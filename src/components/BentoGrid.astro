---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { formatBusinessMetric } from '../utils/format';

export interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const cases: CollectionEntry<'cases'>[] = await getCollection('cases');
const featuredIndex = cases.findIndex((c) => c.data.featured);
const others = cases.filter((_, i) => i !== (featuredIndex >= 0 ? featuredIndex : 0));
---

<section id="cases" class="max-w-6xl mx-auto px-4 md:px-6 pb-24">
  <!-- Header da seção -->
  <div class="mb-8 md:mb-12">
    <span class="inline-block text-xs font-mono font-bold text-brand-accent uppercase tracking-wider mb-3">
      {t('bento.eyebrow')}
    </span>
    <h2 class="font-display text-3xl md:text-4xl font-bold text-brand-text leading-tight">
      {t('bento.title')}
    </h2>
  </div>

  <!-- Grid de cases secundários -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-5 auto-rows-min">
    {others.map((item) => {
      const href = `/${lang}/cases/${item.id}/`;
      const metric = item.data.businessOutcome?.[0];
      return (
        <article
          class="bento-card group relative p-6 rounded-[20px] border border-brand-border bg-brand-surface/60 hover:border-brand-accent/60 hover:bg-brand-surface-2 transition-colors duration-200 motion-safe:transition-all"
        >
          <div class="flex flex-col h-full">
            <h3 class="text-lg font-bold text-brand-text group-hover:text-brand-accent transition-colors duration-200 mb-2">
              {item.data.title}
            </h3>
            <p class="text-sm text-brand-text-secondary line-clamp-3 mb-4">
              {item.data.shortDescription}
            </p>

            {metric && (
              <div class="mb-4">
                <span class="block text-2xl font-black text-brand-accent font-mono">
                  {formatBusinessMetric(metric.value, metric.unit)}
                </span>
                <span class="text-xs text-brand-text-secondary">{metric.label}</span>
              </div>
            )}

            <div class="flex flex-wrap gap-2 mt-auto mb-4">
              {item.data.tags.slice(0, 4).map((tag: string) => (
                <span class="px-2.5 py-1 text-xs font-medium border border-brand-border rounded-full bg-brand-bg/60 text-brand-text-secondary">
                  {tag}
                </span>
              ))}
            </div>

            <a
              href={href}
              class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-accent min-h-[48px] w-fit relative z-10 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent"
              aria-label={`${lang === 'pt' ? 'Ver case' : 'View case'}: ${item.data.title}`}
            >
              {lang === 'pt' ? 'Ver case' : 'View case'}
              <span class="bento-arrow transition-transform duration-200" aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Link overlay acessível -->
          <a
            href={href}
            class="absolute inset-0 z-0 rounded-[20px]"
            aria-hidden="true"
            tabindex="-1"
          >
          </a>
        </article>
      );
    })}
  </div>

  <!-- Link "Ver todos" -->
  <div class="mt-10 md:mt-12 flex justify-center">
    <a
      href={`/${lang}/cases/`}
      class="inline-flex items-center gap-2 px-6 py-3 min-h-[48px] rounded-full border border-brand-border bg-brand-surface/60 text-brand-text font-bold hover:border-brand-accent/60 hover:text-brand-accent transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent"
    >
      {t('bento.cta')}
      <span class="bento-arrow-cta transition-transform duration-200" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  /* Motion: translateY 4px sutil + arrow translateX no hover */
  .bento-card {
    transition-property: border-color, background-color, transform;
    transition-duration: 200ms;
    transition-timing-function: ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bento-card:hover {
      transform: translateY(-4px);
    }
    .group:hover .bento-arrow {
      transform: translateX(6px);
    }
    .bento-arrow-cta:hover,
    a:hover .bento-arrow-cta {
      transform: translateX(4px);
    }
  }

  /* Arrow base transition */
  .bento-arrow,
  .bento-arrow-cta {
    display: inline-block;
  }
</style>
