---
import { getCollection, type CollectionEntry } from 'astro:content';
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const cases: CollectionEntry<'cases'>[] = await getCollection('cases');

// Ordenar por priority manual (menor = primeiro). Sem priority fica por ultimo (ordem alfabetica).
const othersSorted = [...cases].sort((a, b) => {
  const pa = a.data.priority ?? 999;
  const pb = b.data.priority ?? 999;
  if (pa !== pb) return pa - pb;
  return a.id.localeCompare(b.id);
});

const categories = Array.from(new Set(cases.map((c) => c.data.category).filter(Boolean))) as string[];
const filterAll = lang === 'pt' ? 'Todos' : 'All';
const filterLabel = (cat: string) => {
  const map: Record<string, { pt: string; en: string }> = {
    client: { pt: 'Cliente', en: 'Client' },
    personal: { pt: 'Pessoal', en: 'Personal' },
    saas: { pt: 'SaaS', en: 'SaaS' },
    ecommerce: { pt: 'E-commerce', en: 'E-commerce' },
    landing: { pt: 'Landing Page', en: 'Landing Page' },
  };
  return map[cat]?.[lang] ?? cat;
};

const viewCaseLabel = lang === 'pt' ? 'Ver case completo' : 'View full case';
const openAppLabel = lang === 'pt' ? 'Abrir aplicação' : 'Open app';
---

<section id="cases" class="py-20 md:py-28 max-w-6xl mx-auto px-4 md:px-6">
  {/* Header da seção */}
  <div class="mb-10 md:mb-14">
    <span class="inline-block text-xs font-mono font-bold text-brand-accent uppercase tracking-[0.2em] mb-3">
      {t('bento.eyebrow')}
    </span>
    <h2 class="font-display text-3xl md:text-5xl font-black leading-[1.05] tracking-[-0.03em] text-brand-text mb-6">
      {t('bento.title')}
    </h2>

    {/* Filtros por categoria */}
    {categories.length > 1 && (
      <div class="flex flex-wrap gap-2" role="group" aria-label={lang === 'pt' ? 'Filtrar por categoria' : 'Filter by category'}>
        <button
          type="button"
          class="bento-filter px-4 py-2 min-h-[40px] text-sm font-bold rounded-full border border-brand-border bg-brand-surface/60 text-brand-text hover:border-brand-accent/60 hover:text-brand-accent transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent"
          data-filter="all"
          aria-pressed="true"
        >
          {filterAll}
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            class="bento-filter px-4 py-2 min-h-[40px] text-sm font-bold rounded-full border border-brand-border bg-brand-surface/40 text-brand-text-secondary hover:border-brand-accent/60 hover:text-brand-accent transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent"
            data-filter={cat}
            aria-pressed="false"
          >
            {filterLabel(cat)}
          </button>
        ))}
      </div>
    )}
  </div>

  {/* Grid de cases — 3 colunas desktop, 2 tablet, 1 mobile */}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6 auto-rows-min">
    {othersSorted.map((item) => {
      const href = `/${lang}/cases/${item.id}/`;
      const liveUrl = item.data.liveUrl;
      const heroImage = `/cases/${item.id}-hero.jpg`;
      const logoPath = item.data.heroImage ?? `/cases/${item.id}.svg`;
      const category = item.data.category ?? 'client';
      const domain = liveUrl ? new URL(liveUrl).hostname : '';
      const metrics = item.data.businessOutcome?.slice(0, 3) ?? [];
      return (
        <article
          class="bento-card group relative overflow-hidden rounded-3xl border border-brand-border bg-gradient-to-br from-brand-surface/80 to-brand-bg/60 shadow-[0_16px_60px_-20px_rgba(0,0,0,0.5)] md:backdrop-blur-md hover:border-brand-accent/60 transition-colors duration-200 motion-safe:transition-all motion-safe:duration-200"
          data-category={category}
        >
          {/* Ambient gradients — só no desktop */}
          <div class="absolute inset-0 pointer-events-none hidden md:block" aria-hidden="true">
            <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-brand-accent-secondary/10 to-transparent"></div>
            <div class="absolute bottom-0 left-0 w-full h-1/2 bg-gradient-to-t from-brand-bg/70 to-transparent"></div>
          </div>

          {/* Mockup de browser com screenshot do hero */}
          <div class="relative bg-brand-bg/60 border-b border-brand-border">
            {/* Barra do browser */}
            <div class="flex items-center gap-2 px-3 py-2.5 bg-brand-surface/80 border-b border-brand-border">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
              <div class="flex-1 ml-2 px-2.5 py-1 rounded-md bg-brand-bg/60 text-[10px] text-brand-text-secondary font-mono truncate border border-brand-border">
                {domain}
              </div>
            </div>
            {/* Screenshot do hero */}
            <div class="relative overflow-hidden">
              <img
                src={heroImage}
                alt={`Screenshot do produto ${item.data.title} — ${item.data.clientName} ao vivo`}
                width="1440"
                height="900"
                loading="lazy"
                decoding="async"
                class="w-full h-auto block transition-transform duration-300 motion-safe:group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-bg/50 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
            </div>
          </div>

          {/* Conteúdo embaixo */}
          <div class="relative p-5 md:p-6">
            {/* Logo + cliente */}
            <div class="inline-flex items-center gap-2.5 mb-3">
              <img
                src={logoPath}
                alt={`Logo ${item.data.clientName} — ${item.data.title}`}
                width="32"
                height="32"
                loading="lazy"
                decoding="async"
                class="w-7 h-7 md:w-8 md:h-8 object-contain rounded-lg shrink-0"
              />
              <span class="text-[11px] font-medium text-brand-text-secondary font-mono truncate">
                {item.data.clientName}
              </span>
            </div>

            {/* Título */}
            <h3 class="font-display text-xl font-black leading-[1.1] tracking-[-0.02em] text-brand-text group-hover:text-brand-accent transition-colors duration-200 mb-2">
              {item.data.title}
            </h3>

            {/* Descrição */}
            <p class="text-sm text-brand-text-secondary mb-4 leading-relaxed line-clamp-2">
              {item.data.shortDescription}
            </p>

            {/* Métricas compactas */}
            {metrics.length > 0 && (
              <div class="grid grid-cols-3 gap-2 mb-4">
                {metrics.map((metric) => (
                  <div class="border-l-2 border-brand-accent/30 pl-2">
                    <span class="block text-base font-black text-brand-accent font-mono leading-none">
                      {metric.value}{metric.unit || ''}
                    </span>
                    <span class="text-[9px] text-brand-text-secondary mt-0.5 block truncate">{metric.label}</span>
                  </div>
                ))}
              </div>
            )}

            {/* Dois botões */}
            <div class="flex flex-col sm:flex-row gap-2.5">
              <a
                href={href}
                class="inline-flex items-center justify-center min-h-[40px] px-4 py-2 bg-brand-accent text-brand-bg font-bold text-xs rounded-lg hover:scale-105 motion-safe:transition-transform motion-safe:duration-200 shadow-[0_0_20px_rgba(138,180,248,0.3)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
              >
                {viewCaseLabel} →
              </a>
              {liveUrl && (
                <a
                  href={liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center min-h-[40px] px-4 py-2 border border-brand-border text-brand-text font-semibold text-xs rounded-lg hover:border-brand-accent/60 hover:text-brand-accent motion-safe:transition-colors motion-safe:duration-200 bg-brand-surface/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-accent"
                >
                  {openAppLabel} ↗
                </a>
              )}
            </div>
          </div>

          {/* Link overlay acessível */}
          <a href={href} class="absolute inset-0 z-0 rounded-3xl" aria-hidden="true" tabindex="-1"></a>
        </article>
      );
    })}
  </div>

  {/* Link "Ver todos" */}
  <div class="mt-10 md:mt-14 flex justify-center">
    <a
      href={`/${lang}/cases/`}
      class="inline-flex items-center gap-2 px-6 py-3 min-h-[48px] rounded-full border border-brand-border bg-brand-surface/60 text-brand-text font-bold hover:border-brand-accent/60 hover:text-brand-accent transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent"
    >
      {t('bento.cta')}
      <span class="bento-arrow-cta transition-transform duration-200" aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .bento-card {
    transition-property: border-color, background-color, transform, box-shadow;
    transition-duration: 200ms;
    transition-timing-function: ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bento-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 24px 80px -24px rgba(0, 0, 0, 0.6), 0 0 24px -8px rgba(138, 180, 248, 0.15);
    }
    .group:hover .bento-arrow {
      transform: translateX(6px);
    }
    .bento-arrow-cta:hover,
    a:hover .bento-arrow-cta {
      transform: translateX(4px);
    }
  }

  .bento-arrow,
  .bento-arrow-cta {
    display: inline-block;
  }

  .bento-filter[aria-pressed="true"] {
    background-color: rgba(138, 180, 248, 0.12);
    border-color: rgba(138, 180, 248, 0.6);
    color: #8AB4F8;
  }

  .bento-card.is-hidden {
    display: none;
  }
</style>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.bento-filter');
  const cards = document.querySelectorAll<HTMLElement>('.bento-card');

  filters.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      filters.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');

      cards.forEach((card) => {
        const category = card.dataset.category;
        if (filter === 'all' || category === filter) {
          card.classList.remove('is-hidden');
        } else {
          card.classList.add('is-hidden');
        }
      });
    });
  });
</script>
