---

<section id="packages" class="py-20 md:py-28 max-w-6xl mx-auto px-4 md:px-6" aria-labelledby="packages-title">
  <div class="mb-12">
    <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 flex items-center gap-2">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-accent" aria-hidden="true" />
      {lang === 'pt' ? 'Serviços' : 'Services'}
    </p>
    <h2 id="packages-title" class="font-display text-3xl md:text-5xl text-brand-text tracking-tight mb-4 leading-tight">
      {lang === 'pt' ? 'O que construímos' : 'What we build'}
    </h2>
    <p class="text-lg text-brand-text-secondary leading-relaxed max-w-2xl">
      {lang === 'pt'
        ? 'Prazo e entrega definidos. Sem cobrança por hora, sem escopo aberto, sem surpresa. Cada serviço tem início, meio e fim claros.'
        : 'Timeline and deliverables set. No hourly billing, no open scope, no surprises. Every service has a clear start, middle and end.'}
    </p>
    <p class="mt-3 text-sm text-brand-accent font-semibold">
      {lang === 'pt'
        ? 'O produto é seu. Código, domínio e infraestrutura sob seu controle quando aplicável. Sem lock-in.'
        : 'The product is yours. Code, domain and infrastructure under your control when applicable. No lock-in.'}
    </p>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-list>
    {packages.map((pkg) => (
      <article class={`relative p-6 rounded-2xl border transition-colors motion-reduce:transition-none flex flex-col ${pkg.id === 'saas' ? 'border-brand-accent bg-brand-surface/70 shadow-[0_0_40px_-10px_rgba(138,180,248,0.25)]' : 'border-brand-border bg-brand-surface/40 hover:border-brand-accent/40'}`}>
        <span class={`absolute -top-3 left-6 px-3 py-1 text-[10px] font-mono font-bold uppercase tracking-wider rounded-full ${pkg.id === 'saas' ? 'bg-brand-accent text-brand-bg' : 'bg-brand-accent text-brand-bg'}`}>
          {pkg.id === 'saas' ? (lang === 'pt' ? 'Mais pedido' : 'Most requested') : pkg.tag[lang]}
        </span>
        <h3 class="font-display text-2xl text-brand-text mb-2">
          {pkg.name[lang]}
        </h3>
        <p class="text-sm text-brand-text-secondary mb-4">{pkg.desc[lang]}</p>
        <div class="mb-4">
          <span class="text-sm font-bold text-brand-accent font-mono block">{pkg.price[lang]}</span>
          <span class="block text-xs text-brand-text-secondary mt-1">{pkg.time[lang]}</span>
        </div>
        <ul class="space-y-2 mb-6 flex-1">
          {pkg.features.slice(0, 5).map((f) => (
            <li class="flex items-start gap-2 text-sm text-brand-text-secondary">
              <svg class="w-4 h-4 text-brand-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {f[lang]}
            </li>
          ))}
        </ul>
        <div class="flex flex-col gap-2">
          <a
            href={`/${lang}/contato/`}
            class="inline-flex items-center justify-center min-h-[48px] px-5 py-3 bg-brand-accent text-brand-bg font-bold rounded-xl hover:scale-105 motion-safe:transition-transform motion-safe:duration-200 shadow-[0_0_24px_rgba(138,180,248,0.35)] text-center"
          >
            {pkg.cta[lang]}
          </a>
          <button
            type="button"
            class="package-detail-btn inline-flex items-center justify-center min-h-[44px] px-5 py-2 border border-brand-border text-brand-text-secondary font-semibold text-sm rounded-xl hover:border-brand-accent/60 hover:text-brand-accent transition-colors motion-safe:duration-200"
            data-package={pkg.id}
            aria-label={lang === 'pt' ? `Ver detalhes do pacote ${pkg.name[lang]}` : `View details for ${pkg.name[lang]}`}
          >
            {lang === 'pt' ? 'Ver detalhes' : 'View details'}
          </button>
        </div>
      </article>
    ))}
  </div>
</section>

{/* Modais de detalhes */}
{packages.map((pkg) => (
  <div
    class="package-modal fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/70 backdrop-blur-sm"
    data-modal={pkg.id}
    role="dialog"
    aria-modal="true"
    aria-labelledby={`modal-title-${pkg.id}`}
  >
    <div class="relative max-w-2xl w-full max-h-[90vh] overflow-y-auto rounded-3xl border border-brand-border bg-brand-bg shadow-2xl">
      {/* Header */}
      <div class="sticky top-0 z-10 flex items-center justify-between p-6 border-b border-brand-border bg-brand-bg">
        <div>
          <span class="inline-block px-3 py-1 text-[10px] font-mono font-bold uppercase tracking-wider bg-brand-accent text-brand-bg rounded-full mb-2">
            {pkg.tag[lang]}
          </span>
          <h3 id={`modal-title-${pkg.id}`} class="font-display text-2xl text-brand-text">
            {pkg.name[lang]}
          </h3>
          <p class="text-xs text-brand-text-secondary mt-1">{pkg.time[lang]}</p>
        </div>
        <button
          type="button"
          class="package-close-btn w-10 h-10 rounded-full border border-brand-border text-brand-text-secondary hover:text-brand-text hover:border-brand-accent/60 transition-colors flex items-center justify-center shrink-0"
          aria-label={lang === 'pt' ? 'Fechar' : 'Close'}
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>

      {/* Conteúdo */}
      <div class="p-6">
        {/* Descrição longa */}
        <p class="text-sm md:text-base text-brand-text-secondary leading-relaxed mb-6">
          {pkg.longDesc[lang]}
        </p>

        {/* Preço */}
        <div class="mb-6 p-4 rounded-2xl border border-brand-border bg-brand-surface/40">
          <span class="text-xs font-mono uppercase tracking-widest text-brand-text-secondary block mb-1">
            {lang === 'pt' ? 'Investimento' : 'Investment'}
          </span>
          <span class="text-lg font-black text-brand-accent font-mono">{pkg.price[lang]}</span>
          <span class="text-xs text-brand-text-secondary block mt-1">{pkg.time[lang]}</span>
        </div>

        {/* Features completas */}
        <h4 class="font-display text-lg text-brand-text mb-3">
          {lang === 'pt' ? 'O que está incluído' : 'What is included'}
        </h4>
        <ul class="grid sm:grid-cols-2 gap-2 mb-6">
          {pkg.features.map((f) => (
            <li class="flex items-start gap-2 text-sm text-brand-text-secondary">
              <svg class="w-4 h-4 text-brand-accent shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {f[lang]}
            </li>
          ))}
        </ul>

        {/* Entregáveis */}
        <h4 class="font-display text-lg text-brand-text mb-3">
          {lang === 'pt' ? 'Entregáveis' : 'Deliverables'}
        </h4>
        <div class="flex flex-wrap gap-2 mb-6">
          {pkg.deliverables[lang].map((d) => (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-mono text-brand-text-secondary rounded-lg border border-brand-border bg-brand-surface/40">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-accent" aria-hidden="true"></span>
              {d}
            </span>
          ))}
        </div>

        {/* CTA */}
        <a
          href={`/${lang}/contato/`}
          class="inline-flex items-center justify-center min-h-[48px] w-full px-5 py-3 bg-brand-accent text-brand-bg font-bold rounded-xl hover:scale-[1.02] motion-safe:transition-transform motion-safe:duration-200 shadow-[0_0_24px_rgba(138,180,248,0.35)] text-center"
        >
          {pkg.cta[lang]} →
        </a>
        <p class="text-center text-xs text-brand-text-secondary mt-3">
          {lang === 'pt' ? 'Resposta em até 24h · Sem compromisso' : 'Reply within 24h · No commitment'}
        </p>
      </div>
    </div>
  </div>
))}

<script>
  const detailBtns = document.querySelectorAll<HTMLButtonElement>('.package-detail-btn');
  const modals = document.querySelectorAll<HTMLElement>('.package-modal');
  const closeBtns = document.querySelectorAll<HTMLButtonElement>('.package-close-btn');

  function openModal(id: string) {
    const modal = document.querySelector<HTMLElement>(`[data-modal="${id}"]`);
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
      const closeBtn = modal.querySelector<HTMLButtonElement>('.package-close-btn');
      closeBtn?.focus();
    }
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  detailBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-package');
      if (id) openModal(id);
    });
  });

  closeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const modal = btn.closest<HTMLElement>('.package-modal');
      if (modal) closeModal(modal);
    });
  });

  modals.forEach((modal) => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal(modal);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      modals.forEach((modal) => {
        if (!modal.classList.contains('hidden')) closeModal(modal);
      });
    }
  });
</script>
