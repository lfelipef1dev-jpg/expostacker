---
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="lead-magnet" class="py-20 md:py-28 max-w-6xl mx-auto px-4 md:px-6" aria-labelledby="lead-magnet-title">
  <div class="relative overflow-hidden rounded-3xl border border-brand-border bg-gradient-to-br from-brand-surface/80 to-brand-bg/60 p-8 md:p-12">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-brand-accent/8 to-transparent pointer-events-none" aria-hidden="true" />
    <div class="relative max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-accent" aria-hidden="true" />
        {lang === 'pt' ? 'Download grátis' : 'Free download'}
      </p>
      <h2 id="lead-magnet-title" class="font-display text-2xl md:text-4xl text-brand-text tracking-tight mb-4 leading-tight">
        {lang === 'pt'
          ? 'Checklist: 10 perguntas antes de construir seu produto digital'
          : 'Checklist: 10 questions before building your digital product'}
      </h2>
      <p class="text-brand-text-secondary leading-relaxed mb-8">
        {lang === 'pt'
          ? 'A maioria dos produtos falha antes do primeiro commit. Esse checklist ajuda você a validar a ideia, o mercado e o timing antes de investir no build.'
          : 'Most products fail before the first commit. This checklist helps you validate the idea, market and timing before investing in the build.'}
      </p>
      <form
        action="https://formspree.io/f/xqkovpya"
        method="POST"
        class="flex flex-col sm:flex-row gap-3"
      >
        <input
          type="email"
          name="email"
          required
          placeholder={lang === 'pt' ? 'Seu melhor e-mail' : 'Your best email'}
          class="flex-1 min-h-[48px] px-4 rounded-xl bg-brand-bg/80 border border-brand-border text-brand-text placeholder:text-brand-text-secondary/50 focus:outline-none focus:ring-2 focus:ring-brand-accent"
        />
        <input type="hidden" name="_subject" value={lang === 'pt' ? 'Quero o checklist de validação' : 'I want the product validation checklist'} />
        <input type="hidden" name="message" value={lang === 'pt' ? 'Quero receber o checklist gratuito.' : 'I want to receive the free checklist.'} />
        <button
          type="submit"
          class="inline-flex items-center justify-center min-h-[48px] px-6 py-3 bg-brand-accent text-brand-bg font-bold rounded-xl hover:scale-105 motion-safe:transition-transform motion-safe:duration-200 shadow-[0_0_24px_rgba(138,180,248,0.35)] whitespace-nowrap"
        >
          {lang === 'pt' ? 'Quero o checklist' : 'Get the checklist'}
        </button>
      </form>
      <p class="text-xs text-brand-text-secondary/70 mt-4">
        {lang === 'pt' ? 'Sem spam. Você recebe o link em até 24h.' : 'No spam. You get the link within 24h.'}
      </p>
    </div>
  </div>
</section>
