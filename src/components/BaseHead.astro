---
// BaseHead.astro — head unificado com @graph, CWV, GA4 e segurança

export interface Props {
  title: string;
  description: string;
  lang: 'pt' | 'en';
  canonicalUrl: string;
  ptUrl: string;
  enUrl: string;
  xDefaultUrl: string;
  ogImage?: string;
  keywords?: string;
  type?: 'website' | 'article';
  breadcrumbs?: { name: string; url: string }[];
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  authorUrl?: string;
  speakableSelectors?: string[];
}

const {
  title,
  description,
  lang,
  canonicalUrl,
  ptUrl,
  enUrl,
  xDefaultUrl,
  ogImage,
  keywords,
  type = 'website',
  breadcrumbs,
  datePublished,
  dateModified,
  authorName,
  authorUrl,
  speakableSelectors,
} = Astro.props;

const SITE_URL = 'https://expostacker.com.br';
const SITE_NAME = 'Expo Stacker';
const DEFAULT_OG_IMAGE = `${SITE_URL}/og-image.png`;
const resolvedOgImage = ogImage ?? DEFAULT_OG_IMAGE;

const ogLocale = lang === 'pt' ? 'pt_BR' : 'en_US';
const ogLocaleAlternate = lang === 'pt' ? 'en_US' : 'pt_BR';

const defaultKeywords = lang === 'pt'
  ? 'desenvolvimento de produtos digitais, SaaS, e-commerce, landing page, MVP, desenvolvimento de software, desenvolvedor full stack, Astro, Next.js, Cloudflare, Supabase, deploy automático, produtos digitais ao vivo, plataforma SaaS, loja virtual, site profissional, SEO técnico, automação com IA, inteligência artificial, chatbot, RAG'
  : 'digital product development, SaaS, e-commerce, landing page, MVP, software development, full stack developer, Astro, Next.js, Cloudflare, Supabase, automatic deploy, live digital products, SaaS platform, online store, professional website, technical SEO, AI automation, artificial intelligence, chatbot, RAG';

const resolvedKeywords = keywords ?? defaultKeywords;

const authorFullName = authorName ?? (lang === 'pt' ? 'Luis Felipe' : 'Luis Felipe');
const authorPage = authorUrl ?? `${SITE_URL}/${lang}/sobre/`;

// IDs estáveis para @graph
const orgId = `${SITE_URL}/#organization`;
const websiteId = `${SITE_URL}/#website`;
const personId = `${SITE_URL}/#person`;
const webpageId = `${canonicalUrl}#webpage`;
const articleId = type === 'article' ? `${canonicalUrl}#article` : undefined;

// Entidades
const organization = {
  '@type': 'Organization',
  '@id': orgId,
  name: SITE_NAME,
  url: SITE_URL,
  logo: {
    '@type': 'ImageObject',
    url: `${SITE_URL}/logo.png`,
    width: 512,
    height: 128,
  },
  founder: { '@id': personId },
  sameAs: [
    'https://github.com/lfelipef1dev-jpg',
    'https://www.linkedin.com/in/lfelipef1dev',
  ],
  areaServed: lang === 'pt' ? 'Brasil e exterior' : 'Brazil and worldwide',
  knowsAbout: [
    'SaaS development',
    'E-commerce development',
    'Web development',
    'AI automation',
    'Cloudflare',
    'Supabase',
    'Astro',
    'Next.js',
    'TypeScript',
    'PostgreSQL',
  ],
};

const person = {
  '@type': 'Person',
  '@id': personId,
  name: authorFullName,
  url: authorPage,
  jobTitle: lang === 'pt' ? 'Desenvolvedor de Produtos Digitais' : 'Digital Product Developer',
  worksFor: { '@id': orgId },
  sameAs: [
    'https://github.com/lfelipef1dev-jpg',
    'https://www.linkedin.com/in/lfelipef1dev',
  ],
  knowsAbout: [
    'SaaS development',
    'E-commerce development',
    'Web development',
    'AI automation',
    'Cloudflare',
    'Supabase',
    'Astro',
    'Next.js',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: SITE_NAME,
  url: SITE_URL,
  inLanguage: ['pt-BR', 'en-US'],
  publisher: { '@id': orgId },
};

const webpage = {
  '@type': 'WebPage',
  '@id': webpageId,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: lang === 'pt' ? 'pt-BR' : 'en-US',
  isPartOf: { '@id': websiteId },
  about: { '@id': orgId },
  ...(speakableSelectors && {
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: speakableSelectors,
    },
  }),
};

let graph: any[] = [organization, person, website, webpage];

if (type === 'article' && articleId) {
  const article = {
    '@type': 'Article',
    '@id': articleId,
    headline: title,
    description,
    image: resolvedOgImage,
    url: canonicalUrl,
    author: { '@id': personId },
    publisher: { '@id': orgId },
    datePublished: datePublished ?? '2025-01-01',
    dateModified: dateModified ?? datePublished ?? '2025-01-01',
    inLanguage: lang === 'pt' ? 'pt-BR' : 'en-US',
    mainEntityOfPage: { '@id': webpageId },
  };
  graph.push(article);
  // WebPage aponta para o Article como mainEntity
  (webpage as any).mainEntity = { '@id': articleId };
}

if (breadcrumbs && breadcrumbs.length > 0) {
  const breadcrumbList = {
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumbs`,
    itemListElement: breadcrumbs.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  };
  graph.push(breadcrumbList);
  (webpage as any).breadcrumb = { '@id': `${canonicalUrl}#breadcrumbs` };
}

const schemaScript = {
  '@context': 'https://schema.org',
  '@graph': graph,
};

const ga4Id = (import.meta.env as any).PUBLIC_GA4_ID ?? '';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={resolvedKeywords} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="author" content={authorFullName} />
<meta name="theme-color" content="#0A0A0F" />
<link rel="canonical" href={canonicalUrl} />

<!-- Favicon -->
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- Preload logo for LCP optimization -->
<link rel="preload" as="image" href="/logo.png" fetchpriority="high" />

<!-- DNS prefetch and preconnect for external resources -->
<link rel="dns-prefetch" href="https://fonts.googleapis.com" />
<link rel="dns-prefetch" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- hreflang -->
<link rel="alternate" hreflang="pt-BR" href={ptUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlternate} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />

<!-- JSON-LD structured data -->
<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaScript)} />

<!-- GA4 -->
{ga4Id && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${ga4Id}',{send_page_view:true});`} />
    <script is:inline set:html={`document.addEventListener('DOMContentLoaded',function(){document.body.addEventListener('click',function(e){var a=e.target.closest('a[href]');if(!a)return;var h=a.getAttribute('href');if(h&&h.includes('wa.me'))gtag('event','whatsapp_click');if(h&&h.startsWith('mailto:'))gtag('event','email_click');if(h&&h.startsWith('tel:'))gtag('event','phone_click');});var f=document.querySelector('form');if(f)f.addEventListener('submit',function(){gtag('event','generate_lead');});});`} />
  </>
)}
