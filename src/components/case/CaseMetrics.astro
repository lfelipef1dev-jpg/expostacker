---
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { formatBusinessMetric } from '../../utils/format';

export interface Props {
  lang: keyof typeof ui;
  entry: any;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);

const metrics = entry?.data?.businessOutcome ?? [];
---

<section class="max-w-6xl mx-auto px-4 md:px-6" aria-labelledby="case-metrics-title">
  <div class="mb-8 max-w-2xl">
    <h2
      id="case-metrics-title"
      class="font-display text-2xl md:text-3xl text-brand-text mb-3 leading-tight"
    >
      {t('case.results')}
    </h2>
    <p class="text-sm text-brand-text-secondary leading-relaxed">
      {t('case.resultsSource')}
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    {
      metrics.map((metric: any) => (
        <article class="p-6 rounded-2xl bg-brand-surface/60 border border-brand-border">
          <span class="font-display text-2xl md:text-3xl text-brand-accent block leading-tight">
            {formatBusinessMetric(metric.value, metric.unit, lang)}
          </span>
          <span class="font-mono text-xs uppercase text-brand-text-secondary block mt-2">
            {metric.label}
          </span>
          {metric.context && (
            <p class="text-sm text-brand-text-secondary mt-3 leading-relaxed">
              {metric.context}
            </p>
          )}
        </article>
      ))
    }
  </div>

  <p class="mt-6 text-xs text-brand-text-secondary leading-relaxed">
    {t('case.sourceClient')}
  </p>
</section>
