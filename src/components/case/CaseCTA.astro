---
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
  entry: any;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);

const ctaTitle =
  entry?.data?.ctaTitle?.[lang] ??
  (lang === 'pt' ? 'Quer um produto como esse?' : 'Want a product like this?');

const ctaText =
  entry?.data?.ctaText?.[lang] ??
  (lang === 'pt'
    ? 'Posso fazer o mesmo para o seu negócio. Vamos conversar.'
    : 'I can do the same for your business. Let\'s talk.');
---

<section class="max-w-6xl mx-auto px-4 md:px-6 py-12 md:py-16 text-center">
  <h2 class="font-display text-3xl md:text-4xl text-brand-text mb-4">
    {ctaTitle}
  </h2>
  <p class="text-brand-text-secondary mb-8 max-w-2xl mx-auto">
    {ctaText}
  </p>
  <div class="flex flex-wrap items-center justify-center gap-3">
    {entry.data.liveUrl && (
      <a
        href={entry.data.liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center min-w-[48px] min-h-[48px] px-6 py-3 bg-brand-accent text-brand-bg font-semibold rounded-lg transition-transform hover:scale-[1.02] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand-bg"
      >
        {t('case.openApp')}
      </a>
    )}
    <a
      href={`/${lang}/contato/`}
      class="inline-flex items-center justify-center min-w-[48px] min-h-[48px] px-6 py-3 border border-brand-border text-brand-text font-semibold rounded-lg hover:border-brand-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand-bg"
    >
      {t('case.contact')}
    </a>
    {entry.data.githubUrl && (
      <a
        href={entry.data.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center min-w-[48px] min-h-[48px] px-6 py-3 border border-brand-border text-brand-text font-semibold rounded-lg hover:border-brand-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand-bg"
      >
        GitHub
      </a>
    )}
  </div>
</section>
