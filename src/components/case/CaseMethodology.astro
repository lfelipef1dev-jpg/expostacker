---
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
  entry: any;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);

const steps: string[] = entry.data.methodology?.[lang] ?? [];
---

<section class="py-12 md:py-16 max-w-6xl mx-auto px-4 md:px-6">
  <h2 class="font-display text-2xl md:text-3xl text-brand-text">
    {t('case.methodology')}
  </h2>

  <p class="mt-4 text-brand-text-secondary leading-relaxed">
    Como o projeto foi conduzido, do mapeamento ao deploy.
    <span lang="en" class="block text-brand-text-secondary/80">
      How the project was conducted, from mapping to deploy.
    </span>
  </p>

  <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {steps.map((step, index) => (
      <div class="p-5 rounded-lg bg-brand-surface/60 border border-brand-border">
        <div class="font-display text-2xl text-brand-accent">
          {index + 1}
        </div>
        <p class="mt-3 text-sm text-brand-text-secondary leading-relaxed">
          {step}
        </p>
      </div>
    ))}
  </div>
</section>
