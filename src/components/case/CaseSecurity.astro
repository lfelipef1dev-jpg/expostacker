---
export interface Props {
  lang: keyof typeof ui;
  entry: any;
}

import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

const { lang, entry } = Astro.props;
const t = useTranslations(lang);

const security = entry?.data?.security?.[lang];
const title = security?.title || '';
const items = security?.items || [];

const icons = [
  // lock
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><rect x="8.5" y="11" width="7" height="5" rx="1"/><path d="M10 11V9a2 2 0 0 1 4 0v2"/></svg>',
  // person
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="9.5" r="2.2"/><path d="M7.5 17.5a4.5 4.5 0 0 1 9 0"/></svg>',
  // shield
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 7l4 1.5v3.5c0 2.5-1.7 4.3-4 5-2.3-.7-4-2.5-4-5V8.5L12 7z"/></svg>',
  // robot
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><rect x="8" y="10" width="8" height="6" rx="1"/><path d="M12 7v3"/><circle cx="10" cy="13" r="0.6" fill="currentColor"/><circle cx="14" cy="13" r="0.6" fill="currentColor"/></svg>',
  // key
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="10" cy="12" r="2"/><path d="M12 12h5M15 12v2M17 12v2"/></svg>',
];
---

<section class="py-12 md:py-16 max-w-6xl mx-auto px-4 md:px-6">
  <h2 class="font-display text-2xl md:text-3xl text-brand-text">
    {t('case.security')}
  </h2>

  {title && (
    <p class="mt-2 text-brand-text-secondary leading-relaxed">
      {title}
    </p>
  )}

  {items?.length > 0 && (
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      {items.map((item: any, index: number) => (
        <li class="bg-brand-surface/60 border border-brand-border rounded-2xl p-5">
          <span class="text-brand-accent inline-block w-6 h-6" set:html={icons[index % icons.length]} />
          <p class="mt-2 text-brand-text-secondary leading-relaxed">
            {item?.text || item}
          </p>
        </li>
      ))}
    </ul>
  )}
</section>
