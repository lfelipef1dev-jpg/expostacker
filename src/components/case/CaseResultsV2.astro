---
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
  entry: any;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);

const kpis = entry?.data?.resultsDetail?.[lang]?.kpis ?? entry?.data?.businessOutcome ?? [];

const points = (sparkline: number[]) => {
  const max = Math.max(...sparkline);
  const min = Math.min(...sparkline);
  const range = max - min || 1;
  return sparkline
    .map((v, i) => `${(i / (sparkline.length - 1)) * 100},${40 - ((v - min) / range) * 35 - 2}`)
    .join(' ');
};
---

<section class="py-12 md:py-16 max-w-6xl mx-auto px-4 md:px-6" aria-labelledby="case-results-v2-title">
  <div class="mb-8">
    <h2
      id="case-results-v2-title"
      class="font-display text-2xl md:text-3xl text-brand-text mb-3 leading-tight"
    >
      {t('case.results')}
    </h2>
    <p class="text-sm text-brand-text-secondary leading-relaxed">
      {t('case.resultsSource')}
    </p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
    {
      kpis.map((kpi: any) => (
        <article class="bg-brand-surface/60 border border-brand-border rounded-xl p-4">
          <span class="font-display text-2xl md:text-3xl text-brand-accent block leading-tight">
            {kpi.value}
            {kpi.unit && <span class="text-lg md:text-xl">{kpi.unit}</span>}
          </span>
          <span class="font-mono text-[11px] uppercase text-brand-text-secondary block mt-2">
            {kpi.label}
          </span>

          {kpi.baseline && (
            <p class="text-[11px] text-brand-text-secondary mt-2">
              Baseline: {kpi.baseline}
            </p>
          )}

          {kpi.source && (
            <p class="text-[11px] text-brand-text-secondary mt-1">
              Fonte: {kpi.source}
            </p>
          )}

          {kpi.sparkline && Array.isArray(kpi.sparkline) && kpi.sparkline.length > 1 && (
            <svg
              viewBox="0 0 100 40"
              preserveAspectRatio="none"
              class="w-full mt-3"
              style="height: 32px;"
              aria-hidden="true"
            >
              <polyline
                points={points(kpi.sparkline)}
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-brand-accent"
              />
            </svg>
          )}
        </article>
      ))
    }
  </div>

  <p class="mt-4 text-xs text-brand-text-secondary leading-relaxed">
    {t('case.sourceClient')}
  </p>
</section>
