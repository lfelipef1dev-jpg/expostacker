---
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
  entry: any;
  slug: string;
}

const { lang, entry, slug } = Astro.props;
const t = useTranslations(lang);

const heroMetrics = entry?.data?.heroMetrics ?? [];
const stackBadges = (entry?.data?.tags ?? []).slice(0, 6);
const liveUrl = entry?.data?.liveUrl ?? '#';
const hasLiveUrl = Boolean(entry?.data?.liveUrl);
const heroImage = entry?.data?.heroImage ?? null;
const eyebrow = lang === 'pt' ? 'PRODUTO EM PRODUÇÃO' : 'LIVE PRODUCT';

// Cache busting e slug serao usados no script client-side
---

<section
  class="relative w-full bg-brand-bg overflow-hidden"
  aria-labelledby="case-hero-title"
>
  {/* Gradient mesh + grid pattern overlay */}
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
    style="background:
      radial-gradient(ellipse 80% 60% at 20% 0%, rgba(var(--brand-accent-rgb, 99 102 241) / 0.12), transparent 60%),
      radial-gradient(ellipse 60% 50% at 90% 10%, rgba(var(--brand-accent-rgb, 99 102 241) / 0.08), transparent 55%);"
  >
  </div>
  <div
    class="absolute inset-0 pointer-events-none opacity-[0.04]"
    aria-hidden="true"
    style="background-image:
      linear-gradient(to right, var(--brand-border, #1f2937) 1px, transparent 1px),
      linear-gradient(to bottom, var(--brand-border, #1f2937) 1px, transparent 1px);
      background-size: 56px 56px;"
  >
  </div>

  <div class="relative max-w-6xl mx-auto px-4 pt-2 md:pt-3">
    {/* Eyebrow */}
    <span class="font-mono text-xs uppercase tracking-wider text-brand-accent inline-flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-brand-accent animate-pulse" aria-hidden="true"></span>
      {eyebrow}
    </span>

    {/* H1 — right below eyebrow, full width */}
    <h1
      id="case-hero-title"
      class="mt-3 font-display font-bold text-brand-text leading-[1.1]"
      style="font-size: clamp(1.75rem, 3.5vw + 0.5rem, 3rem);"
    >
      {entry?.data?.title}
    </h1>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 py-8 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-10 lg:gap-12 items-end">
      {/* Left: text content + CTAs */}
      <div class="flex flex-col gap-5 h-full justify-end">
        {/* Subhead */}
        <p class="text-base md:text-lg text-brand-text-secondary leading-relaxed">
          {entry?.data?.heroHeadline?.[lang] ?? entry?.data?.heroSubhead?.[lang] ?? entry?.data?.shortDescription}
        </p>

        {/* CTAs */}
        <div class="flex flex-col sm:flex-row gap-4">
          {
            hasLiveUrl && (
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center min-h-12 px-6 py-3 rounded-xl bg-brand-accent text-brand-bg font-semibold text-center transition-transform hover:scale-[1.02] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand-bg"
              >
                {t('case.openApp')}
                <svg class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M7 17L17 7M17 7H8M17 7V16" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )
          }
          <a
            href="#arquitetura"
            class="inline-flex items-center justify-center min-h-12 px-6 py-3 rounded-xl border border-brand-border text-brand-text font-semibold text-center transition-colors hover:border-brand-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand-bg"
          >
            {t('case.architecture')}
          </a>
        </div>
      </div>

      {/* Right: browser mockup */}
      <div class="mt-2 lg:mt-0">
        <div class="relative rounded-xl border border-brand-border bg-brand-surface/80 overflow-hidden shadow-2xl shadow-black/40">
          {/* Browser bar */}
          <div class="flex items-center gap-2 px-4 py-3 border-b border-brand-border bg-brand-elevated">
            <span class="w-3 h-3 rounded-full bg-red-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/70"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/70"></span>
            <div class="ml-3 flex-1 h-6 rounded-md bg-brand-bg/60 px-3 flex items-center">
              <span class="font-mono text-[11px] text-brand-text-secondary truncate">
                {liveUrl?.replace('https://', '') ?? 'marken.expostacker.com.br'}
              </span>
            </div>
          </div>
          {/* App preview area */}
          <div
            class="relative aspect-[4/3] min-h-[300px] md:min-h-[400px] bg-gradient-to-br from-brand-surface to-brand-bg overflow-hidden"
            id={`preview-${slug}`}
          >
            {/* Iframe (live preview) */}
            {hasLiveUrl && (
              <script is:inline define:vars={{ slug, liveUrl, previewTitle: entry?.data?.title }}>
                (function(){
                  var container = document.getElementById('preview-' + slug);
                  if (!container) return;
                  var ts = Date.now().toString(36);
                  var sep = liveUrl.indexOf('?') > -1 ? '&' : '?';
                  var url = liveUrl + sep + 'b=' + ts;
                  var frame = document.createElement('iframe');
                  frame.src = url;
                  frame.className = 'absolute inset-0 w-full h-full border-0 bg-brand-bg';
                  frame.setAttribute('loading', 'eager');
                  frame.setAttribute('scrolling', 'yes');
                  frame.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-forms allow-popups allow-modals allow-downloads');
                  frame.setAttribute('title', previewTitle + ' — live preview');
                  container.appendChild(frame);
                })();
              </script>
            )}
            {/* Hero image fallback (only if no liveUrl) */}
            {!hasLiveUrl && heroImage && (
              <picture class="contents">
                {heroImage.endsWith('.jpg') && (
                  <source srcset={heroImage.replace('.jpg', '.webp')} type="image/webp" />
                )}
                <img
                  src={heroImage}
                  alt={`${entry?.data?.title} — preview`}
                  class="absolute inset-0 w-full h-full object-cover"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  width="1200"
                  height="630"
                />
              </picture>
            )}
            {/* Placeholder layer (only if no liveUrl and no heroImage) */}
            {!hasLiveUrl && !heroImage && (
              <div class="absolute inset-0 p-6 flex flex-col gap-4">
                {/* Placeholder: stylized app UI */}
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-lg bg-brand-accent/20 border border-brand-accent/30"></div>
                    <div class="space-y-1">
                      <div class="h-2 w-20 rounded-full bg-brand-text-secondary/30"></div>
                      <div class="h-1.5 w-14 rounded-full bg-brand-text-secondary/20"></div>
                    </div>
                  </div>
                  <div class="flex gap-1.5">
                    <div class="w-6 h-6 rounded-full bg-brand-accent/15"></div>
                    <div class="w-6 h-6 rounded-full bg-brand-accent/15"></div>
                    <div class="w-6 h-6 rounded-full bg-brand-accent/15"></div>
                  </div>
                </div>
                <div class="grid grid-cols-3 gap-3 mt-2">
                  <div class="rounded-lg border border-brand-border bg-brand-surface/60 p-3 space-y-2">
                    <div class="h-6 w-10 rounded bg-brand-accent/30"></div>
                    <div class="h-1.5 w-full rounded-full bg-brand-text-secondary/20"></div>
                    <div class="h-1.5 w-2/3 rounded-full bg-brand-text-secondary/15"></div>
                  </div>
                  <div class="rounded-lg border border-brand-border bg-brand-surface/60 p-3 space-y-2">
                    <div class="h-6 w-10 rounded bg-brand-accent/30"></div>
                    <div class="h-1.5 w-full rounded-full bg-brand-text-secondary/20"></div>
                    <div class="h-1.5 w-2/3 rounded-full bg-brand-text-secondary/15"></div>
                  </div>
                  <div class="rounded-lg border border-brand-border bg-brand-surface/60 p-3 space-y-2">
                    <div class="h-6 w-10 rounded bg-brand-accent/30"></div>
                    <div class="h-1.5 w-full rounded-full bg-brand-text-secondary/20"></div>
                    <div class="h-1.5 w-2/3 rounded-full bg-brand-text-secondary/15"></div>
                  </div>
                </div>
                <div class="mt-2 rounded-lg border border-brand-border bg-brand-surface/60 p-4 space-y-3">
                  <div class="flex items-center justify-between">
                    <div class="h-2 w-24 rounded-full bg-brand-text-secondary/25"></div>
                    <div class="h-2 w-8 rounded-full bg-brand-accent/40"></div>
                  </div>
                  <div class="space-y-2">
                    <div class="flex items-center gap-2">
                      <div class="w-4 h-4 rounded-full border-2 border-brand-accent/40"></div>
                      <div class="h-1.5 flex-1 rounded-full bg-brand-text-secondary/15"></div>
                    </div>
                    <div class="flex items-center gap-2">
                      <div class="w-4 h-4 rounded-full bg-brand-accent/40"></div>
                      <div class="h-1.5 flex-1 rounded-full bg-brand-text-secondary/15"></div>
                    </div>
                    <div class="flex items-center gap-2">
                      <div class="w-4 h-4 rounded-full border-2 border-brand-border"></div>
                      <div class="h-1.5 flex-1 rounded-full bg-brand-text-secondary/10"></div>
                    </div>
                  </div>
                </div>
              </div>
            )}
            {/* Overlay hint */}
            <div class="absolute bottom-3 right-3 px-2.5 py-1 rounded-md bg-brand-bg/80 border border-brand-border pointer-events-none">
              <span class="font-mono text-[10px] text-brand-text-secondary flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
                live preview
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Stack badges — centered below the split */}
    {
      stackBadges.length > 0 && (
        <div class="mt-12 flex flex-wrap items-center justify-center gap-2">
          <span class="font-mono text-xs text-brand-text-secondary">
            {t('case.techStack')}:
          </span>
          {stackBadges.map((tech: string) => (
            <span class="font-mono text-xs px-2.5 py-1 rounded-md border border-brand-border bg-brand-surface/60 text-brand-text-secondary">
              {tech}
            </span>
          ))}
        </div>
      )
    }

    {/* Hero metrics — centered below badges */}
    {
      heroMetrics.length > 0 && (
        <dl class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-8 max-w-2xl mx-auto text-center">
          {heroMetrics.slice(0, 3).map((metric: any) => (
            <div class="flex flex-col gap-1 items-center">
              <dd class="font-display text-3xl md:text-5xl text-brand-accent leading-none">
                {metric?.value}
              </dd>
              <dt class="text-xs md:text-sm text-brand-text-secondary">
                {metric?.label?.[lang] ?? metric?.label}
              </dt>
            </div>
          ))}
        </dl>
      )
    }

    {/* Demo access — only for cases with demo credentials */}
    {hasLiveUrl && entry?.data?.demoAccess && (
      <div class="mt-10 max-w-md mx-auto rounded-xl border border-brand-border bg-brand-surface/60 p-5 text-center">
        <p class="font-mono text-xs uppercase tracking-wider text-brand-accent mb-3">
          {lang === 'pt' ? 'Acesso de teste' : 'Test access'}
        </p>
        <div class="space-y-2 font-mono text-sm">
          <div class="flex items-center justify-between gap-4">
            <span class="text-brand-text-secondary">e-mail</span>
            <span class="text-brand-text select-all">{entry.data.demoAccess.email}</span>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span class="text-brand-text-secondary">senha</span>
            <span class="text-brand-text select-all">{entry.data.demoAccess.password}</span>
          </div>
        </div>
        <ol class="mt-4 text-left text-xs text-brand-text-secondary space-y-1 px-2">
          <li><span class="text-brand-accent font-bold">1</span> {lang === 'pt' ? 'Acesse com o login acima' : 'Log in with the details above'}</li>
          <li><span class="text-brand-accent font-bold">2</span> {lang === 'pt' ? 'Navegue pelo painel e veja os fluxos' : 'Browse the dashboard and see the flows'}</li>
          <li><span class="text-brand-accent font-bold">3</span> {lang === 'pt' ? 'Teste o fluxo principal de conversão' : 'Test the main conversion flow'}</li>
        </ol>
        <a
          href={liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center justify-center gap-2 min-h-11 px-5 py-2.5 rounded-lg bg-brand-accent text-brand-bg font-semibold text-sm transition-transform hover:scale-[1.02]"
        >
          {lang === 'pt' ? 'Usar agora' : 'Use now'}
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M7 17L17 7M17 7H8M17 7V16" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none !important;
    }
    a:hover {
      transform: none !important;
    }
  }
</style>
