---
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
  entry: any;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);

const phases: Array<{ period?: string; phase?: string; items?: { pt?: string[]; en?: string[] } }> =
  entry.data.timelinePhases ?? [];
const localizedItems = (items: any): string[] => {
  if (Array.isArray(items)) return items;
  if (items && typeof items === 'object') return items[lang] ?? items.pt ?? items.en ?? [];
  return [];
};
---

<section class="py-12 md:py-16 max-w-6xl mx-auto px-4 md:px-6">
  <h2 class="font-display text-2xl md:text-3xl text-brand-text">
    {t('case.timeline')}
  </h2>

  <p class="mt-4 text-brand-text-secondary leading-relaxed">
    Como o projeto foi conduzido, do mapeamento ao deploy.
    <span lang="en" class="block text-brand-text-secondary/80">
      How the project was conducted, from mapping to deploy.
    </span>
  </p>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
    {phases.map((phase) => (
      <div class="relative pl-6 border-l-2 border-brand-border">
        <span
          class="absolute left-0 w-4 h-4 rounded-full bg-brand-accent border-2 border-brand-bg"
          style="transform: translateX(-50%); top: 0.25rem;"
        >
        </span>

        {phase.period && (
          <p class="font-mono text-xs uppercase text-brand-accent">
            {phase.period}
          </p>
        )}

        {phase.phase && (
          <h3 class="mt-1 font-display text-lg text-brand-text">
            {phase.phase}
          </h3>
        )}

        {localizedItems(phase.items).length > 0 && (
          <ul class="mt-3 space-y-2">
            {localizedItems(phase.items).map((item) => (
              <li class="text-sm text-brand-text-secondary leading-relaxed">
                {item}
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</section>
