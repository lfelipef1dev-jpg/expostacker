---
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
  entry: any;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);

const categories = entry.data.techStack?.[lang]?.categories ?? [];
---

<section class="py-12 md:py-16">
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <h2 class="font-display text-2xl md:text-3xl text-brand-text">
      {t('case.techStack')}
    </h2>
    <p class="mt-3 text-brand-text-secondary">
      {lang === 'pt' ? 'Escolhas técnicas e o que ficou para fora.' : 'Technical choices and what was left out.'}
    </p>

    <div class="mt-10 space-y-10">
      {categories.map((category: any) => (
        <div>
          <h3 class="font-display text-xl text-brand-text">
            {category?.category}
          </h3>

          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {category?.items?.map((item: any) => (
              <div class="bg-brand-surface/60 border border-brand-border rounded-2xl p-5">
                <span class="inline-block rounded-full border border-brand-border px-2.5 py-1 font-mono text-brand-accent uppercase text-xs">
                  {item?.name}
                </span>
                <p class="mt-4 text-brand-text">
                  <strong class="font-semibold">{t('case.why')}:</strong>{' '}
                  {item?.why}
                </p>
                <p class="mt-2 text-brand-text-secondary text-sm">
                  <strong class="font-semibold">{t('case.alt')}:</strong>{' '}
                  {item?.alt}
                </p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
