---
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { formatBusinessMetric } from '../../utils/format';

export interface Props {
  lang: keyof typeof ui;
  entry: any;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
---

<section class="w-full bg-brand-bg py-16 md:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6">
      <span class="font-mono uppercase tracking-widest text-brand-text-secondary text-xs inline-flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse" aria-hidden="true"></span>
        {entry.data.projectType}
      </span>

      <div class="flex flex-wrap items-center gap-3">
        <h1 class="font-display text-3xl md:text-5xl font-bold text-brand-text leading-tight">
          {entry.data.heroHeadline?.[lang] ?? entry.data.title}
        </h1>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-brand-border bg-brand-surface font-mono text-xs uppercase text-brand-text">
          <span class="w-2 h-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          {t('case.live')}
        </span>
      </div>

      <p class="text-lg md:text-xl text-brand-text-secondary max-w-3xl">
        {entry.data.heroSubhead?.[lang] ?? entry.data.shortDescription}
      </p>

      <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {entry.data.businessOutcome?.slice(0, 3).map((metric: any) => (
          <div class="bg-brand-surface border border-brand-border rounded-lg p-6">
            <dd class="font-display text-2xl md:text-3xl text-brand-accent">
              {formatBusinessMetric(metric.value, metric.unit, lang)}
            </dd>
            <dt class="font-mono text-xs text-brand-text-secondary uppercase mt-1">
              {metric.label}
            </dt>
          </div>
        ))}
      </dl>

      <div class="flex flex-col sm:flex-row gap-4 mt-2">
        <a
          href={entry.data.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="min-h-[48px] inline-flex items-center justify-center px-6 py-3 rounded bg-brand-accent text-brand-bg font-medium text-center"
        >
          {t('case.openApp')}
        </a>
        <a
          href="#case-content"
          class="min-h-[48px] inline-flex items-center justify-center px-6 py-3 rounded border border-brand-border text-brand-text hover:border-brand-accent font-medium text-center"
        >
          {t('case.readCase')}
        </a>
      </div>
    </div>
  </div>
</section>
