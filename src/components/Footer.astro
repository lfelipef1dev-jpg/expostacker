---
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="border-t border-brand-surface bg-brand-surface/30 mt-auto">
  <div class="max-w-6xl mx-auto px-4 md:px-6 py-8 flex flex-col md:flex-row items-center justify-between gap-4">
    <a href={`/${lang}/`} class="text-lg font-black text-white">
      <span class="text-brand-accent">EXPO</span> STACKER
    </a>
    <p class="text-sm text-slate-400 text-center md:text-right">
      {t('footer.copyright')}
    </p>
  </div>
</footer>
