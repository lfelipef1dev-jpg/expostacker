---
import { ui } from '../i18n/ui';

export interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;

const differentials = [
  {
    icon: 'product',
    title: lang === 'pt' ? 'Produto, não apenas código' : 'Product, not just code',
    desc: lang === 'pt'
      ? 'O objetivo é colocar software funcionando nas mãos dos usuários. Não entregamos código — entregamos produtos prontos para serem usados.'
      : 'The goal is to put working software in the hands of users. We do not deliver code — we deliver products ready to be used.',
  },
  {
    icon: 'ownership',
    title: lang === 'pt' ? 'Transparência' : 'Transparency',
    desc: lang === 'pt'
      ? 'O cliente acompanha a evolução do projeto. Entregas incrementais, demos ao vivo e comunicação direta. Sem camadas desnecessárias.'
      : 'The client follows the project evolution. Incremental deliveries, live demos and direct communication. No unnecessary layers.',
  },
  {
    icon: 'price',
    title: lang === 'pt' ? 'Arquitetura preparada para evolução' : 'Architecture prepared for evolution',
    desc: lang === 'pt'
      ? 'Construímos pensando além da primeira versão. O produto nasce pronto para receber novas funcionalidades sem retrabalho.'
      : 'We build thinking beyond the first version. The product is born ready to receive new features without rework.',
  },
  {
    icon: 'weekly',
    title: lang === 'pt' ? 'Sem dependência artificial' : 'No artificial dependency',
    desc: lang === 'pt'
      ? 'Quando aplicável, domínio, código, infraestrutura e contas permanecem sob controle do cliente. Sem lock-in.'
      : 'When applicable, domain, code, infrastructure and accounts remain under the client control. No lock-in.',
  },
  {
    icon: 'deploy',
    title: lang === 'pt' ? 'Comunicação direta' : 'Direct communication',
    desc: lang === 'pt'
      ? 'Processo objetivo, sem gerente de contas no meio. Você fala diretamente com quem constrói. Decisões rápidas, sem ruído.'
      : 'Objective process, no account manager in between. You talk directly to the builder. Fast decisions, no noise.',
  },
  {
    icon: 'serverless',
    title: lang === 'pt' ? 'Engenharia + visão de produto' : 'Engineering + product vision',
    desc: lang === 'pt'
      ? 'Não apenas implementamos funcionalidades. Pensamos em como o produto será utilizado, como escala e como gera valor.'
      : 'We do not just implement features. We think about how the product will be used, how it scales and how it generates value.',
  },
];
---

<section class="py-20 md:py-28 bg-brand-surface/20 border-y border-brand-border" aria-labelledby="why-title">
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 flex items-center gap-2">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-accent" aria-hidden="true"></span>
        {lang === 'pt' ? 'Por que ExpoStacker' : 'Why ExpoStacker'}
      </p>
      <h2 id="why-title" class="font-display text-3xl md:text-5xl text-brand-text tracking-tight leading-tight mb-4">
        {lang === 'pt' ? 'Por que ExpoStacker?' : 'Why ExpoStacker?'}
      </h2>
      <p class="text-lg text-brand-text-secondary leading-relaxed">
        {lang === 'pt'
          ? 'Construímos produtos digitais com engenharia, visão de produto e processo claro.'
          : 'We build digital products with engineering, product vision and a clear process.'}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {differentials.map((d) => (
        <article class="flex flex-col gap-3 p-6 rounded-2xl border border-brand-border bg-brand-surface/40 hover:border-brand-accent/40 transition-colors motion-reduce:transition-none">
          <div class="w-10 h-10 rounded-xl border border-brand-accent/30 bg-brand-accent/10 flex items-center justify-center text-brand-accent">
            {d.icon === 'product' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {d.icon === 'ownership' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" />
                <path d="M7 11V7a5 5 0 0110 0v4" stroke-linecap="round" />
              </svg>
            )}
            {d.icon === 'price' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {d.icon === 'weekly' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <path d="M16 2v4M8 2v4M3 10h18" stroke-linecap="round" />
              </svg>
            )}
            {d.icon === 'deploy' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {d.icon === 'serverless' && (
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
          </div>
          <h3 class="font-display text-lg text-brand-text leading-snug">
            {d.title}
          </h3>
          <p class="text-sm text-brand-text-secondary leading-relaxed">
            {d.desc}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
