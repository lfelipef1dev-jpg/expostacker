---
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative min-h-[85vh] flex items-center pt-24 pb-20 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-[-10%] right-[-10%] w-[40rem] h-[40rem] rounded-full bg-gradient-to-br from-brand-accent/10 to-violet-500/5 blur-[100px]"></div>
    <div class="absolute bottom-[-10%] left-[-5%] w-[32rem] h-[32rem] rounded-full bg-gradient-to-tr from-cyan-500/8 to-transparent blur-[90px]"></div>
  </div>

  <div class="relative w-full max-w-6xl mx-auto px-4 md:px-6">
    <div class="max-w-3xl">
      <p class="inline-flex items-center gap-2 px-3.5 py-1.5 mb-8 text-xs font-bold uppercase tracking-widest text-brand-accent border border-brand-accent/25 rounded-full bg-brand-accent/8 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-brand-accent animate-pulse"></span>
        {t('status.active')}
      </p>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-black leading-[0.98] tracking-[-0.04em] text-white mb-6">
        {t('hero.title')}
      </h1>

      <p class="text-lg md:text-xl text-slate-300/90 max-w-2xl mb-10 leading-relaxed">
        {t('hero.subtitle')}
      </p>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <a href="#cases" class="inline-flex items-center justify-center px-7 py-4 bg-brand-accent text-brand-bg font-bold rounded-xl hover:scale-105 transition-transform shadow-[0_0_32px_rgba(0,225,160,0.35)] min-w-[180px]">
          {t('hero.ctaPrimary')}
        </a>
        <a href={`/${lang}/contato/`} class="inline-flex items-center justify-center px-7 py-4 border border-white/20 text-white font-semibold rounded-xl hover:border-brand-accent/60 hover:text-brand-accent transition-colors min-w-[180px] bg-white/5 backdrop-blur-sm">
          {t('hero.ctaSecondary')}
        </a>
      </div>
    </div>
  </div>
</section>
