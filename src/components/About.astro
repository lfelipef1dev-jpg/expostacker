---
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const stack: { category: string; items: string[] }[] = [
  {
    category: lang === 'pt' ? 'Frontend' : 'Frontend',
    items: ['Next.js', 'React', 'Astro', 'TypeScript', 'Tailwind CSS'],
  },
  {
    category: lang === 'pt' ? 'Backend' : 'Backend',
    items: ['Hono', 'Node.js', 'Express', 'PostgreSQL', 'Supabase', 'Redis', 'D1'],
  },
  {
    category: lang === 'pt' ? 'Auth e Dados' : 'Auth & Data',
    items: ['Better Auth', 'JWT', 'RLS', 'Row Level Security'],
  },
  {
    category: lang === 'pt' ? 'Pagamento' : 'Payments',
    items: ['Mercado Pago', 'Stripe'],
  },
  {
    category: lang === 'pt' ? 'Infra' : 'Infra',
    items: ['Cloudflare Workers', 'Cloudflare Pages', 'R2', 'D1', 'GitHub Actions', 'Docker'],
  },
  {
    category: lang === 'pt' ? 'IA' : 'AI',
    items: ['Groq', 'Gemini', 'Cerebras'],
  },
];

const services = [
  { title: t('about.service1.title'), desc: t('about.service1.desc') },
  { title: t('about.service2.title'), desc: t('about.service2.desc') },
  { title: t('about.service3.title'), desc: t('about.service3.desc') },
  { title: t('about.service4.title'), desc: t('about.service4.desc') },
  { title: t('about.service5.title'), desc: t('about.service5.desc') },
  { title: t('about.service6.title'), desc: t('about.service6.desc') },
  { title: t('about.service7.title'), desc: t('about.service7.desc') },
  { title: t('about.service8.title'), desc: t('about.service8.desc') },
];

const stats = [
  { value: '11', label: t('about.statsProjects') },
  { value: '100%', label: t('about.statsLive') },
  { value: '32', label: t('about.statsTech') },
  { value: 'R$0', label: t('about.statsInfra') },
];
---

<section
  id="about"
  class="py-24 md:py-32 max-w-7xl mx-auto px-6 md:px-10 lg:px-16"
  aria-labelledby="about-title"
>
  <!-- Header -->
  <div class="mb-16">
    <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 flex items-center gap-2">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-accent" aria-hidden="true"></span>
      {t('about.eyebrow')}
    </p>
    <h2
      id="about-title"
      class="font-display text-3xl md:text-5xl lg:text-5xl text-brand-text tracking-tight leading-tight max-w-5xl break-words"
    >
      {t('about.title')}
    </h2>
  </div>

  <!-- Grid principal: bio + serviços / stack + stats -->
  <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-stretch">
    <!-- Coluna esquerda: bio + serviços -->
    <div class="flex flex-col gap-10 h-full">
      <!-- Bio -->
      <p class="text-lg text-brand-text-secondary leading-relaxed">
        {t('about.bio')}
      </p>

      <!-- Serviços -->
      <div class="flex flex-col gap-6 flex-grow">
        <h3 class="font-mono text-sm uppercase tracking-widest text-brand-text-secondary">
          {t('about.servicesTitle')}
        </h3>
        <div class="grid sm:grid-cols-2 gap-3 flex-grow">
          {services.map((service) => (
            <article class="flex flex-col gap-1.5 p-4 rounded-2xl border border-brand-border bg-brand-surface/40 hover:border-brand-accent/40 transition-colors h-full">
              <h4 class="font-display text-sm text-brand-text leading-snug">
                {service.title}
              </h4>
              <p class="text-xs text-brand-text-secondary leading-relaxed">
                {service.desc}
              </p>
            </article>
          ))}
        </div>
      </div>
    </div>

    <!-- Coluna direita: stats + stack -->
    <div class="flex flex-col gap-10 h-full">
      <!-- Stats de prova -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {stats.map((stat) => (
          <div class="flex flex-col gap-1 p-4 rounded-xl border border-brand-border bg-brand-surface/30">
            <span class="font-display text-2xl md:text-3xl font-black text-brand-accent leading-none">
              {stat.value}
            </span>
            <span class="text-xs font-mono text-brand-text-secondary uppercase tracking-wider">
              {stat.label}
            </span>
          </div>
        ))}
      </div>

      <!-- Stack -->
      <div class="flex flex-col gap-6 flex-grow">
        <h3 class="font-mono text-sm uppercase tracking-widest text-brand-text-secondary">
          {t('about.stackTitle')}
        </h3>
        <div class="flex flex-col gap-5 flex-grow">
          {stack.map((group) => (
            <div class="flex flex-col gap-2">
              <p class="font-mono text-xs uppercase tracking-wider text-brand-text-secondary">
                {group.category}
              </p>
              <ul class="flex flex-wrap gap-2" role="list">
                {group.items.map((item) => (
                  <li
                    class="px-3 py-2 min-h-[48px] flex items-center text-sm border border-brand-border rounded-full bg-brand-surface/60 text-brand-text-secondary hover:border-brand-accent/60 transition-colors motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand-bg"
                  >
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Availability -->
  <div class="mt-16">
    <span
      class="inline-flex items-center gap-2 border border-brand-accent/30 bg-brand-accent/8 text-brand-accent rounded-full px-4 py-2 min-h-[48px] text-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent focus-visible:ring-offset-2 focus-visible:ring-offset-brand-bg"
    >
      <span
        class="relative inline-flex h-2 w-2"
        aria-hidden="true"
      >
        <span
          class="absolute inline-flex h-full w-full rounded-full bg-brand-accent opacity-75 motion-reduce:animate-none animate-ping"
        >
        </span>
        <span
          class="relative inline-flex h-2 w-2 rounded-full bg-brand-accent"
        >
        </span>
      </span>
      {t('about.availability')}
    </span>
  </div>
</section>
