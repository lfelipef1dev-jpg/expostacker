---
import { ui } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang: keyof typeof ui;
  githubUrl?: string;
}

const { lang, githubUrl = 'https://github.com/lfelipef1dev-jpg' } = Astro.props;
const t = useTranslations(lang);

const liveUrl = 'https://expostacker.com.br/pt/#cases';

const cards = [
  {
    label: t('proof.card1.label'),
    title: t('proof.card1.title'),
    desc: t('proof.card1.desc'),
    cta: t('proof.card1.cta'),
    href: liveUrl,
    external: false,
  },
  {
    label: t('proof.card2.label'),
    title: t('proof.card2.title'),
    desc: t('proof.card2.desc'),
    cta: t('proof.card2.cta'),
    href: githubUrl,
    external: true,
  },
  {
    label: t('proof.card3.label'),
    title: t('proof.card3.title'),
    desc: t('proof.card3.desc'),
    cta: null,
    href: null,
    external: false,
  },
];
---

<section
  id="proof"
  class="py-24 md:py-32 max-w-7xl mx-auto px-6 md:px-10 lg:px-16"
  aria-labelledby="proof-title"
>
  <div class="mb-16">
    <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4 flex items-center gap-2">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-brand-accent" aria-hidden="true"></span>
      {t('proof.eyebrow')}
    </p>
    <h2
      id="proof-title"
      class="font-display text-3xl md:text-5xl lg:text-6xl text-brand-text mb-4 leading-tight tracking-tight whitespace-nowrap"
    >
      {t('proof.title')}
    </h2>
    <p class="text-brand-text-secondary text-base md:text-lg leading-relaxed max-w-3xl">
      {t('proof.subtitle')}
    </p>
  </div>

  <div class="grid md:grid-cols-3 gap-5 items-stretch">
    {
      cards.map((card) => (
        <article
          class="group p-6 rounded-2xl border border-brand-border bg-brand-surface/60 hover:border-brand-accent/40 transition-colors motion-reduce:transition-none focus-within:border-brand-accent/40 flex flex-col h-full"
        >
          <span class="font-mono text-xs uppercase tracking-widest text-brand-accent block mb-3">
            {card.label}
          </span>
          <h3 class="font-display text-lg text-brand-text mb-2 leading-snug">
            {card.title}
          </h3>
          <p class="text-sm text-brand-text-secondary leading-relaxed mb-4 flex-grow">
            {card.desc}
          </p>
          {card.href && card.cta ? (
            <a
              href={card.href}
              target={card.external ? '_blank' : undefined}
              rel={card.external ? 'noopener noreferrer' : undefined}
              class="inline-flex items-center gap-1 text-sm font-medium text-brand-accent hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-accent rounded-sm motion-reduce:hover:no-underline"
            >
              {card.cta}
              <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <span class="font-mono text-xs text-brand-text-secondary leading-relaxed">
              Next.js · React · Astro · Hono · Supabase · PostgreSQL · Cloudflare Workers · Mercado Pago · IA
            </span>
          )}
        </article>
      ))
    }
  </div>
</section>
